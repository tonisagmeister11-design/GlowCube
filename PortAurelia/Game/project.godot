; Engine configuration file.
; Port Aurelia - open world action game (Godot 4.4)

config_version=5

[application]

config/name="Port Aurelia"
config/description="Open world action game set in the coastal metropolis of Port Aurelia."
config/version="0.9.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.03, 0.04, 0.06, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="PortAurelia"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

Paths="*res://core/paths.gd"
Events="*res://core/events.gd"
InputSetup="*res://core/input_setup.gd"
Settings="*res://core/settings.gd"
AudioManager="*res://audio/audio_manager.gd"
SaveManager="*res://save/save_manager.gd"
Game="*res://core/game.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[importer_defaults]

scene={
"import_script/path": "res://tools/import/scene_post_import.gd",
"meshes/generate_lods": true,
"meshes/create_shadow_meshes": true,
"meshes/light_baking": 0,
"skins/use_named_skins": true,
"animation/import": true,
"animation/fps": 30,
"nodes/root_scale": 1.0
}
texture={
"compress/mode": 2,
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}
wav={
"force/mono": false,
"compress/mode": 2
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="npc"
3d_physics/layer_5="props"
3d_physics/layer_6="ragdoll"
3d_physics/layer_7="triggers"
3d_physics/layer_8="projectile_blockers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
3d/default_gravity=9.81
jolt_physics_3d/simulation/max_bodies=20480

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=2.0
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
limits/cluster_builder/max_clustered_elements=1024
global_illumination/sdfgi/probe_ray_count=0
shading/overrides/force_vertex_shading=false
camera/depth_of_field/depth_of_field_bokeh_quality=1

[shader_globals]

night={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
wind={
"type": "vec2",
"value": Vector2(1, 0.3)
}
sun_dir={
"type": "vec3",
"value": Vector3(0.3, 0.8, 0.4)
}
city_lights={
"type": "float",
"value": 0.0
}
