# Kopieren nach .env und ausfuellen:   cp .env.example .env

# --- Claude ---
# Schluessel von https://console.anthropic.com  (Pflicht)
ANTHROPIC_API_KEY=sk-ant-...

# Modell: claude-opus-5 (klug), claude-sonnet-5 (schneller, guenstiger)
BOT_MODEL=claude-opus-5
# Wie viel Claude nachdenkt: low, medium, high  (medium = schnelle Antworten im Chat)
BOT_EFFORT=medium

# --- Minecraft-Server ---
MC_HOST=localhost
MC_PORT=25565
# Name des Bots im Spiel. Muss zu bot-name in plugins/ClaudeSpawn/config.yml passen.
MC_USERNAME=Claude
# offline   = Server mit online-mode=false (kein Konto noetig)
# microsoft = eigenes Minecraft-Konto fuer den Bot (beim ersten Start Code im Browser eingeben)
MC_AUTH=offline
# auto = Version vom Server abfragen
MC_VERSION=auto

# --- Verhalten ---
# Wer darf Claude Auftraege geben? Leer = alle. Sonst Namen mit Komma: Toni,Max
BOT_OWNERS=
# true = Claude reagiert nur, wenn "Claude" in der Nachricht steht
BOT_REQUIRE_NAME=false
# true = unsichtbar warten, bis jemand /spawn claude tippt (braucht das Plugin)
BOT_STANDBY=true
# Wehrt sich selbst gegen Monster / isst selbststaendig
BOT_SELF_DEFENSE=true
BOT_AUTO_EAT=true
# Darf beim normalen Laufen Bloecke abbauen/setzen (false schuetzt eure Bauten)
BOT_DIG_WHILE_WALKING=false
# Mehr Ausgaben in der Konsole
BOT_DEBUG=false
