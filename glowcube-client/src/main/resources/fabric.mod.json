{
  "schemaVersion": 1,
  "id": "glowcube",
  "version": "${version}",
  "name": "GlowCube",
  "description": "Ein clientseitiger Werkzeugkasten mit X-Ray, ESP, ClickGUI, SeedHunt und OreSim.",
  "authors": ["GlowCube"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["net.glowcube.client.GlowCubeClient"],
    "seedcrackerx": ["net.glowcube.client.integration.SeedBridge"]
  },
  "mixins": [
    {
      "config": "glowcube.mixins.json",
      "environment": "client"
    }
  ],
  "suggests": {
    "seedcrackerx": ">=2.16.0"
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": ">=1.21.11",
    "java": ">=21"
  }
}
