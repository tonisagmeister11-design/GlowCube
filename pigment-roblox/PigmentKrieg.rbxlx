	["Ohne Auswahl geht es in %d s zurück ins Menü"] = "Back to menu in %d s",
	-- Shop & Schmiede
	["Ausgerüstet"] = "Equipped", ["Anziehen"] = "Equip", ["%d Münzen"] = "%d coins", ["Mit VIP-Pass"] = "With VIP Pass",
	["MAX"] = "MAX", ["Verbessern · %d"] = "Upgrade · %d", ["Stufe %d"] = "Level %d", ["Gekauft ✓"] = "Owned ✓",
	["Gekauft: %s  Danke!"] = "Purchased: %s  Thank you!", ["Du hast %s schon!"] = "You already own %s!",
	["Dieser Artikel ist noch nicht eingerichtet (Produkt-ID fehlt)"] = "This item is not set up yet",
	["Dieser Pass ist noch nicht eingerichtet (Pass-ID fehlt)"] = "This pass is not set up yet",
	["Sofort aufs Konto, für Waffen und Helme"] = "Instantly added, for weapons and helmets",
	["Premium-Helm für deine ganze Armee"] = "Premium helmet for your whole army", [" · für immer"] = " · forever",
	["Zu wenig Gold für %s"] = "Not enough gold for %s", ["%s lädt noch %d s"] = "%s ready in %d s",
	["Münzen"] = "coins",
	-- Einheiten
	["Klinge"] = "Blade", ["Speer"] = "Spear", ["Bogen"] = "Bow", ["Schild"] = "Shield", ["Ninja"] = "Ninja", ["Magier"] = "Mage", ["Titan"] = "Titan",
	["Schneller Schwertkämpfer"] = "Fast swordsman", ["Lange Reichweite"] = "Long reach", ["Schießt Pfeile"] = "Shoots arrows",
	["Blockt von vorne"] = "Blocks from the front", ["Blitzschnelle Dolche"] = "Lightning-fast daggers",
	["Explodierende Kugeln"] = "Exploding orbs", ["Hammer mit Flächenschaden"] = "Hammer with area damage",
	-- Stufen
	["Holz"] = "Wood", ["Eisen"] = "Iron", ["Gold"] = "Gold", ["Diamant"] = "Diamond", ["Plasma"] = "Plasma",
	-- Helme
	["Ohne Helm"] = "No helmet", ["Ritterhelm"] = "Knight helm", ["Ninja-Band"] = "Ninja band", ["Wikingerhelm"] = "Viking helm",
	["Spartaner"] = "Spartan", ["Gesichts-Helm"] = "Face helm", ["Königskrone"] = "Royal crown", ["Heiligenschein"] = "Halo",
	["Neon-Visier"] = "Neon visor", ["Flammenkopf"] = "Flame head", ["Drachenhelm"] = "Dragon helm", ["VIP-Krone"] = "VIP crown",
	-- Fähigkeiten & Extras
	["Meteor"] = "Meteor", ["Kriegsschrei"] = "War Cry", ["Heilwelle"] = "Heal Wave",
	["Meteor auf eine Stelle"] = "Drop a meteor anywhere", ["8 Sek. schneller und stärker"] = "8 s faster and stronger",
	["Heilt Armee und Burg"] = "Heals army and castle", ["Rüstung"] = "Armor", ["Pigment-Mine"] = "Pigment mine", ["Burg-Turm"] = "Castle tower",
	["+15 % Leben für alle Krieger"] = "+15% health for all units", ["+3 Gold pro Sekunde"] = "+3 gold per second",
	["Mehr Burgleben, Turm schießt schneller"] = "More castle health, faster tower",
	-- Arenen
	["Graue Steppe"] = "Grey Steppe", ["Vulkankrater"] = "Volcano Crater", ["Eiswüste"] = "Ice Desert",
	["Neon-Kolosseum"] = "Neon Colosseum", ["Goldener Tempel"] = "Golden Temple",
	-- Modi
	["Klassisch"] = "Classic", ["Überleben"] = "Survival", ["Boss-Ansturm"] = "Boss Rush", ["Turbo"] = "Turbo",
	["Hügel-König"] = "King of the Hill", ["Sudden Death"] = "Sudden Death",
	["Zerstöre die feindliche Burg"] = "Destroy the enemy castle",
	["Halte gegen endlose Wellen durch (alle im Team Schwarz)"] = "Survive endless waves together",
	["Alle 45 Sekunden kommt ein Boss-Titan"] = "A boss titan every 45 seconds",
	["Doppelt so viel Gold, halbe Wartezeiten"] = "Double gold, half the cooldowns",
	["Halte die Mitte! Wer zuerst 100 Punkte hat, gewinnt"] = "Hold the middle! First to 100 points wins",
	["Schwache Burgen, harte Treffer, schnelle Runden"] = "Weak castles, hard hits, fast rounds",
	-- Robux
	["VIP"] = "VIP", ["Regenbogen-Waffen"] = "Rainbow Weapons",
	["Doppelte Münzen nach jedem Kampf + VIP-Krone"] = "Double coins after every battle + VIP crown",
	["Alle deine Waffen leuchten in Regenbogenfarben"] = "All your weapons glow in rainbow colors",
	["1.000 Münzen"] = "1,000 coins", ["6.000 Münzen"] = "6,000 coins", ["20.000 Münzen"] = "20,000 coins",
}

function Lang.setLocale(localeId)
	Lang.german = type(localeId) == "string" and localeId:sub(1, 2):lower() == "de"
end

function Lang.t(s, ...)
	if type(s) ~= "string" then return s end
	local out = s
	if not Lang.german and EN[s] then out = EN[s] end
	if select("#", ...) > 0 then out = string.format(out, ...) end
	return out
end

-- Ansage-Texte wie "WELLE 5" übersetzen
function Lang.say(text)
	local n = text:match("^WELLE (%d+)$")
	if n then return Lang.t("WELLE %d", tonumber(n)) end
	return Lang.t(text)
end

return Lang
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">PigmentKriegServer</string><ProtectedString name="Source"><![CDATA[-- Pigment Krieg: Server. Steuert Runden, KI, Kauf-Anfragen und schickt den Zustand an alle Clients.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

Players.CharacterAutoLoads = false

local PK = ReplicatedStorage:WaitForChild("PK")
local Config = require(PK:WaitForChild("Config"))
local Core = require(script:WaitForChild("BattleCore"))
local Data = require(script:WaitForChild("Data"))
local Arena = require(script:WaitForChild("Arena"))
local Rooms = require(script:WaitForChild("Rooms"))
local isRoom = Rooms.isRoom()

-- Netzwerk -------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local FxEvent = Instance.new("RemoteEvent"); FxEvent.Name = "Fx"; FxEvent.Parent = remotes
local Action = Instance.new("RemoteEvent"); Action.Name = "Action"; Action.Parent = remotes
remotes.Parent = PK

local State = Instance.new("Folder")
State.Name = "State"
local UnitsFolder = Instance.new("Folder"); UnitsFolder.Name = "Units"; UnitsFolder.Parent = State
State.Parent = PK

local battle = nil
local phase = "lobby"
local phaseEnd = 0
local arenaIdx = 1
local mode = "classic"
local searchEnd = nil
local unitInst = {}   -- id -> Configuration
local fxQueue = {}
local lastSent = {}   -- id -> {x, hp, moving, dir}

local function setPhase(p, duration)
	phase = p
	phaseEnd = duration and (workspace:GetServerTimeNow() + duration) or 0
	State:SetAttribute("Phase", p)
	State:SetAttribute("PhaseEnd", phaseEnd)
end

local function sideOf(player) return player:GetAttribute("Side") or 0 end

-- Helden-Werte eines Spielers
local function heroParams(player)
	local d = Data.get(player)
	if not d then return {} end
	return { tier = d.wlv.sword, helmet = d.helmet, hpMul = 1 + d.armor * 0.15, name = player.DisplayName,
		skin = player:GetAttribute("Pass_rainbow") and "rainbow" or nil }
end

local function playersOn(side)
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if sideOf(p) == side then table.insert(list, p) end
	end
	return list
end

-- Effekte bündeln: ein Remote-Aufruf pro Frame --------------------------
local function round1(x) return math.floor(x * 10 + 0.5) / 10 end

local function onFx(kind, d)
	if kind == "spawn" then
		local u = d
		local c = Instance.new("Configuration")
		c.Name = tostring(u.id)
		c:SetAttribute("Type", u.type)
		c:SetAttribute("Side", u.side)
		c:SetAttribute("X", round1(u.x))
		c:SetAttribute("Z", round1(u.z))
		c:SetAttribute("HP", math.ceil(u.hp))
		c:SetAttribute("MaxHP", math.ceil(u.maxHp))
		c:SetAttribute("Tier", u.tier)
		c:SetAttribute("Helmet", u.helmet)
		c:SetAttribute("Scale", u.scale)
		c:SetAttribute("Boss", u.boss == true)
		c:SetAttribute("Speed", u.def.speed)
		c:SetAttribute("Moving", false)
		c:SetAttribute("Dir", u.dir)
		c:SetAttribute("Cheer", u.cheer > 0)
		c:SetAttribute("Skin", u.skin or "")
		c:SetAttribute("Hero", u.hero == true)
		c:SetAttribute("Name", u.name or "")
		c:SetAttribute("Owner", u.owner or 0)
		c:SetAttribute("Carry", false)
		c.Parent = UnitsFolder
		unitInst[u.id] = c
		lastSent[u.id] = { x = u.x, hp = u.hp, moving = false, dir = u.dir }
		return
	elseif kind == "attack" then
		table.insert(fxQueue, { "attack", d.id, d.attackN, d.atkDur, d.combo })
		return
	elseif kind == "death" then
		local c = unitInst[d.id]
		if c then
			c:SetAttribute("HP", 0)
			c:SetAttribute("X", round1(d.unit.x))
			unitInst[d.id] = nil
			lastSent[d.id] = nil
			task.delay(3, function() c:Destroy() end)
		end
		table.insert(fxQueue, { "death", d.id, d.dir, round1(d.power), d.cut, d.owner or 0 })
		return
	elseif kind == "proj" then
		local k = d.meteor and "meteor" or (d.orb and "orb" or (d.bolt and "bolt" or "arrow"))
		table.insert(fxQueue, { "proj", d.id, k, round1(d.x), round1(d.y), round1(d.z), round1(d.tz), round1(d.vx), round1(d.vy), d.g, d.side, d.tier })
		return
	elseif kind == "wave" then
		State:SetAttribute("Wave", d.wave)
		return
	elseif kind == "over" then
		table.insert(fxQueue, { "over", d.winner })
		Arena.collapse(3 - d.winner)
		return
	end
	-- alles andere als Tabelle ohne Einheiten-Verweise weiterreichen
	local copy = { kind }
	local t = {}
	for k, v in pairs(d) do
		local tv = type(v)
		if tv == "number" or tv == "string" or tv == "boolean" then t[k] = v
		elseif k == "ids" then t[k] = v end
	end
	copy[2] = t
	table.insert(fxQueue, copy)
end

-- Runden ----------------------------------------------------------------
local function chooseArena()
	local votes = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local v = p:GetAttribute("Vote")
		if v and Config.ARENAS[v] then votes[v] = (votes[v] or 0) + 1 end
	end
	local best, bc = nil, 0
	for i = 1, #Config.ARENAS do
		if (votes[i] or 0) > bc then best = i; bc = votes[i] end
	end
	return best or arenaIdx
end

local function chooseMode()
	local votes = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local v = p:GetAttribute("ModeVote")
		if v and Config.MODES[v] then votes[v] = (votes[v] or 0) + 1 end
	end
	local best, bc = nil, 0
	for _, m in ipairs(Config.MODE_ORDER) do
		if (votes[m] or 0) > bc then best = m; bc = votes[m] end
	end
	return best or "classic"
end

-- stärkste Werte der Spieler auf einer Seite (Turm, Mine, Fähigkeiten)
local function sideOpts(side)
	local list = playersOn(side)
	if #list == 0 then return { ai = true } end
	local o = { ai = false, tower = 0, mine = 0, ab = { meteor = 1, rage = 1, heal = 1 } }
	for _, p in ipairs(list) do
		local d = Data.get(p)
		if d then
			o.tower = math.max(o.tower, d.tower)
			o.mine = math.max(o.mine, d.mine)
			for k in pairs(o.ab) do o.ab[k] = math.max(o.ab[k], d.ab[k]) end
		end
	end
	return o
end

local function clearUnits()
	for _, c in ipairs(UnitsFolder:GetChildren()) do c:Destroy() end
	unitInst = {}
	lastSent = {}
end

local function startRound()
	clearUnits()
	arenaIdx = chooseArena()
	mode = chooseMode()
	-- Überleben: alle spielen zusammen im Team Schwarz
	if mode == "waves" then
		for _, p in ipairs(Players:GetPlayers()) do
			if sideOf(p) == 2 then p:SetAttribute("Side", 1) end
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do p:SetAttribute("Ready", false) end
	searchEnd = nil
	State:SetAttribute("SearchEnd", 0)
	State:SetAttribute("Arena", arenaIdx)
	State:SetAttribute("Mode", mode)
	State:SetAttribute("Wave", 0)
	State:SetAttribute("Winner", 0)
	Arena.build(arenaIdx)
	battle = Core.new(Config, arenaIdx, onFx, mode)
	for s = 1, 2 do battle:configureSide(s, sideOpts(s)) end
	for _, p in ipairs(Players:GetPlayers()) do
		local s = sideOf(p)
		if s == 1 or s == 2 then battle:wantHero(s, p.UserId, heroParams(p)) end
	end
	battle:startCountdown(4)
	setPhase("countdown", 4)
	table.insert(fxQueue, { "round", arenaIdx })
end

-- Ranglisten -------------------------------------------------------------
local winsStore = nil
pcall(function() winsStore = DataStoreService:GetOrderedDataStore("PK_Wins_v1") end)
local nameCache = {}

local function updateLeaderstats(player)
	local d = Data.get(player)
	if not d then return end
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local w = Instance.new("IntValue"); w.Name = "Wins"; w.Parent = ls
		local k = Instance.new("IntValue"); k.Name = "Kills"; k.Parent = ls
		ls.Parent = player
	end
	ls.Wins.Value = d.wins
	ls.Kills.Value = d.kills
end

local function refreshTop()
	if not winsStore then return end
	local ok, pages = pcall(function() return winsStore:GetSortedAsync(false, 10) end)
	if not ok or not pages then return end
	local list = {}
	for _, e in ipairs(pages:GetCurrentPage()) do
		local id = tonumber(e.key)
		local name = id and nameCache[id]
		if id and not name then
			local okN, n = pcall(function() return Players:GetNameFromUserIdAsync(id) end)
			name = okN and n or ("#" .. tostring(id))
			nameCache[id] = name
		end
		table.insert(list, { n = name or "?", w = e.value })
	end
	State:SetAttribute("Top", HttpService:JSONEncode(list))
end
task.spawn(function()
	while true do
		refreshTop()
		task.wait(60)
	end
end)

local function endRound(winner)
	State:SetAttribute("Winner", winner)
	local a = Config.ARENAS[arenaIdx]
	for _, p in ipairs(Players:GetPlayers()) do
		local s = sideOf(p)
		if s == 1 or s == 2 then
			local kills = battle.kills[p.UserId] or 0
			local won = s == winner
			local coins
			if mode == "waves" then
				won = false
				coins = 20 + battle.wave * 18 + kills * 3
				Data.setBestWave(p, battle.wave)
			else
				coins = (won and a.reward or 25) + kills * 3
				if mode == "boss" and won then coins = coins + 60 end
			end
			local vip = p:GetAttribute("Pass_vip") == true
			if vip then coins = coins * 2 end
			Data.reward(p, coins, won, kills)
			updateLeaderstats(p)
			if won and winsStore then
				local dd = Data.get(p)
				task.spawn(function() pcall(function() winsStore:SetAsync(tostring(p.UserId), dd.wins) end) end)
			end
			FxEvent:FireClient(p, { { "reward", { coins = coins, won = won, kills = kills, wave = battle.wave, vip = vip } } })
		end
	end
	-- Nach dem Kampf: Spieler entscheiden selbst (Nochmal oder Menü). Nach 30 s geht es zurück ins Menü.
	setPhase("end", 30)
end

-- Spieler-Aktionen ------------------------------------------------------
local lastAction = {}
local heroInputT = {}

Action.OnServerEvent:Connect(function(player, kind, a, b)
	-- Helden-Steuerung: eigene, großzügigere Bremse (max. 30 pro Sekunde)
	if kind == "hero" then
		local t = os.clock()
		if t - (heroInputT[player] or 0) < 0.033 then return end
		heroInputT[player] = t
		if battle and (phase == "battle" or phase == "countdown") then battle:heroInput(player.UserId, a, b == true) end
		return
	end
	-- einfache Flutbremse
	local now = os.clock()
	local la = lastAction[player] or 0
	if now - la < 0.05 then return end
	lastAction[player] = now

	local d = Data.get(player)
	if not d then return end
	local side = sideOf(player)

	local function joinSide(s)
		if mode == "waves" and battle and not battle.over and phase ~= "end" then s = 1 end
		player:SetAttribute("Side", s)
		player:SetAttribute("Ready", false)
		if battle and not battle.over and (phase == "battle" or phase == "countdown") then
			local wasAI = battle.ai[s].on
			local o = sideOpts(s)
			battle:setControl(s, false)
			battle.abLv[s] = o.ab
			battle:wantHero(s, player.UserId, heroParams(player))
			if wasAI and #playersOn(3 - s) > 0 then
				table.insert(fxQueue, { "announce", { text = "EIN GEGNER IST BEIGETRETEN!", cls = "boss" } })
			end
		end
	end
	if kind == "side" and (a == 1 or a == 2) then
		player:SetAttribute("Training", false)
		joinSide(a)
	elseif kind == "play" then
		-- Schnelles Spiel: ins Team mit weniger Spielern
		player:SetAttribute("Training", false)
		local n1, n2 = #playersOn(1), #playersOn(2)
		if sideOf(player) == 1 then n1 = n1 - 1 elseif sideOf(player) == 2 then n2 = n2 - 1 end
		joinSide(n2 < n1 and 2 or 1)
	elseif kind == "training" then
		player:SetAttribute("Training", true)
		if sideOf(player) == 0 then joinSide(1) end
	elseif kind == "roomCreate" or kind == "roomJoin" then
		local last = player:GetAttribute("RoomT") or 0
		if os.clock() - last < 3 then return end
		player:SetAttribute("RoomT", os.clock())
		local ok, res
		if kind == "roomCreate" then ok, res = Rooms.create(player) else ok, res = Rooms.join(player, a) end
		FxEvent:FireClient(player, { { "room", { ok = ok, msg = ok and "" or res, code = ok and res or "" } } })
	elseif kind == "vote" and Config.ARENAS[a] then
		player:SetAttribute("Vote", a)
	elseif kind == "modeVote" and type(a) == "string" and Config.MODES[a] then
		player:SetAttribute("ModeVote", a)
	elseif kind == "again" and phase == "end" and (side == 1 or side == 2) then
		player:SetAttribute("Ready", true)
	elseif kind == "menu" then
		player:SetAttribute("Side", 0)
		player:SetAttribute("Ready", false)
		if battle then battle:dropHero(player.UserId) end
	elseif kind == "spawn" and battle and (side == 1 or side == 2) and Config.UNITS[a] and phase == "battle" then
		battle:spawn(side, a, { tier = d.wlv[a], helmet = d.helmet, hpMul = 1 + d.armor * 0.15, owner = player.UserId,
			skin = player:GetAttribute("Pass_rainbow") and "rainbow" or nil })
	elseif kind == "ability" and battle and (side == 1 or side == 2) and Config.ABILITIES[a] and phase == "battle" then
		battle.abLv[side][a] = math.max(battle.abLv[side][a] or 1, d.ab[a])
		battle:useAbility(side, a, tonumber(b), player.UserId)
	elseif kind == "cmd" and battle and (side == 1 or side == 2) and (a == "attack" or a == "defend") then
		battle.cmd[side] = a
	elseif kind == "helmet" and type(a) == "string" then
		Data.buyHelmet(player, a)
	elseif kind == "upgrade" and type(a) == "string" then
		Data.upgradeWeapon(player, a)
	elseif kind == "abilityUp" and type(a) == "string" then
		Data.upgradeAbility(player, a)
	elseif kind == "extra" and type(a) == "string" then
		Data.upgradeExtra(player, a)
	end
end)

-- Robux: Game-Pässe prüfen ----------------------------------------------
local function checkPasses(player)
	for key, pass in pairs(Config.PASSES) do
		if pass.id ~= 0 then
			local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id) end)
			if ok and owns then player:SetAttribute("Pass_" .. key, true) end
		end
	end
	if player:GetAttribute("Pass_vip") then
		local d = Data.get(player)
		if d and not d.owned.vipcrown then d.owned.vipcrown = true; Data.publish(player) end
	end
end
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, bought)
	if not bought then return end
	for key, pass in pairs(Config.PASSES) do
		if pass.id == passId then player:SetAttribute("Pass_" .. key, true) end
	end
	checkPasses(player)
end)

-- Robux: Entwickler-Produkte (Münzen, Premium-Helme) ----------------------
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player or not Data.get(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
	for key, prod in pairs(Config.PRODUCTS) do
		if prod.id ~= 0 and prod.id == info.ProductId then
			if Data.grantProduct(player, key, info.PurchaseId) then
				FxEvent:FireClient(player, { { "bought", { name = prod.name } } })
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

local function welcome(player)
	updateLeaderstats(player)
	if isRoom and (State:GetAttribute("Room") or "") == "" then
		local code = Rooms.codeFromJoin(player)
		if code then State:SetAttribute("Room", code) end
	end
	local r = Data.daily(player)
	if r then
		task.delay(4, function()
			if player.Parent then FxEvent:FireClient(player, { { "daily", r } }) end
		end)
	end
end

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute("Side", 0)
	Data.load(player)
	checkPasses(player)
	welcome(player)
	if player.Character then player.Character:Destroy() end
end)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		p:SetAttribute("Side", 0)
		Data.load(p)
		checkPasses(p)
		welcome(p)
	end)
end
Players.PlayerRemoving:Connect(function(player)
	local s = sideOf(player)
	heroInputT[player] = nil
	if battle then battle:dropHero(player.UserId) end
	Data.release(player)
	lastAction[player] = nil
	task.defer(function()
		if battle and (s == 1 or s == 2) and #playersOn(s) == 0 then battle:setControl(s, true) end
	end)
end)

-- Zustand an Clients ----------------------------------------------------
local syncAcc = 0
local function sync()
	for s = 1, 2 do
		State:SetAttribute("Gold" .. s, math.floor(battle.gold[s]))
		State:SetAttribute("BaseHP" .. s, math.max(0, math.ceil(battle.bases[s].hp)))
		State:SetAttribute("BaseMax" .. s, math.ceil(battle.bases[s].maxHp))
		State:SetAttribute("Cmd" .. s, battle.cmd[s])
		State:SetAttribute("Rage" .. s, round1(battle.rage[s]))
		State:SetAttribute("AI" .. s, battle.ai[s].on)
		State:SetAttribute("Kills" .. s, battle.sideKills[s])
		for _, t in ipairs(Config.UNIT_ORDER) do
			State:SetAttribute("Cd" .. s .. "_" .. t, round1(math.max(0, battle.spawnCd[s][t] or 0)))
		end
		for _, k in ipairs(Config.ABILITY_ORDER) do
			State:SetAttribute("Ab" .. s .. "_" .. k, round1(math.max(0, battle.abCd[s][k] or 0)))
			State:SetAttribute("AbMax" .. s .. "_" .. k, round1(battle:abilityCd(s, k)))
		end
	end
	State:SetAttribute("BossId", battle.boss and battle.boss.id or 0)
	State:SetAttribute("Hill1", math.floor(battle.hill[1]))
	State:SetAttribute("Hill2", math.floor(battle.hill[2]))
	State:SetAttribute("Pig1", battle.pig[1]); State:SetAttribute("Pig2", battle.pig[2])
	State:SetAttribute("Score1", battle.score[1]); State:SetAttribute("Score2", battle.score[2])
	for _, u in ipairs(battle.units) do
		local c = unitInst[u.id]
		local ls = lastSent[u.id]
		if c and ls then
			if math.abs(ls.x - u.x) > 0.5 then c:SetAttribute("X", round1(u.x)); ls.x = u.x end
			if math.abs(ls.hp - u.hp) > 0.5 then c:SetAttribute("HP", math.max(0, math.ceil(u.hp))); ls.hp = u.hp end
			if ls.moving ~= u.moving then c:SetAttribute("Moving", u.moving); ls.moving = u.moving end
			if ls.dir ~= u.dir then c:SetAttribute("Dir", u.dir); ls.dir = u.dir end
			local ch = u.cheer > 0
			if c:GetAttribute("Cheer") ~= ch then c:SetAttribute("Cheer", ch) end
			if u.hero and c:GetAttribute("Carry") ~= (u.carry == true) then c:SetAttribute("Carry", u.carry == true) end
			local vic = u.victory == true
			if vic and not c:GetAttribute("Victory") then c:SetAttribute("Victory", true) end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	local now = workspace:GetServerTimeNow()
	local anyPlayer = #playersOn(1) + #playersOn(2) > 0

	if phase == "lobby" then
		local h1, h2 = #playersOn(1), #playersOn(2)
		local training = false
		for _, p in ipairs(Players:GetPlayers()) do
			if p:GetAttribute("Training") and sideOf(p) ~= 0 then training = true end
		end
		if h1 + h2 == 0 then
			if searchEnd then searchEnd = nil; State:SetAttribute("SearchEnd", 0) end
		elseif (h1 > 0 and h2 > 0) or training or chooseMode() == "waves" then
			startRound()
		elseif isRoom then
			-- privater Raum: auf den Freund warten, kein Computer
			if searchEnd then searchEnd = nil; State:SetAttribute("SearchEnd", 0) end
		else
			if not searchEnd then
				searchEnd = now + Config.SEARCH_TIME
				State:SetAttribute("SearchEnd", searchEnd)
			end
			if now >= searchEnd then startRound() end
		end
	elseif phase == "countdown" or phase == "battle" then
		battle:update(dt)
		if phase == "countdown" and now >= phaseEnd then setPhase("battle") end
		if battle.over and phase == "battle" then endRound(battle.result) end
		if not anyPlayer and phase == "battle" and not battle.over then
			-- niemand spielt mehr: Runde abbrechen
			clearUnits()
			setPhase("lobby")
		end
	elseif phase == "end" then
		battle:update(dt)
		local sided, ready = 0, 0
		for _, p in ipairs(Players:GetPlayers()) do
			local s = sideOf(p)
			if s == 1 or s == 2 then
				sided = sided + 1
				if p:GetAttribute("Ready") then ready = ready + 1 end
			end
		end
		if sided == 0 then
			clearUnits(); setPhase("lobby")
		elseif ready == sided then
			startRound()
		elseif now >= phaseEnd then
			-- wer nicht "Nochmal" gedrückt hat, kommt ins Menü
			for _, p in ipairs(Players:GetPlayers()) do
				if not p:GetAttribute("Ready") then p:SetAttribute("Side", 0) end
			end
			if ready > 0 then startRound() else clearUnits(); setPhase("lobby") end
		end
	end

	if battle then
		syncAcc = syncAcc + dt
		if syncAcc >= 1 / 12 then
			syncAcc = 0
			sync()
		end
	end
	if #fxQueue > 0 then
		FxEvent:FireAllClients(fxQueue)
		fxQueue = {}
	end
end)

-- Gesichtsbild: aus der Decal-Nummer die eigentliche Bild-ID holen
task.spawn(function()
	local img = tostring(Config.FACE_IMAGE or "")
	if img == "" and (Config.FACE_DECAL or 0) ~= 0 then
		local ok, model = pcall(function() return game:GetService("InsertService"):LoadAsset(Config.FACE_DECAL) end)
		if ok and model then
			local dec = model:FindFirstChildWhichIsA("Decal", true)
			if dec then img = dec.Texture end
			model:Destroy()
		end
	end
	if img:match("^%d+$") then img = "rbxassetid://" .. img end
	State:SetAttribute("FaceImage", img)
end)

setPhase("lobby")
State:SetAttribute("Arena", arenaIdx)
Arena.build(arenaIdx)
print("[PigmentKrieg] Server bereit")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">BattleCore</string><ProtectedString name="Source"><![CDATA[-- Pigment Krieg: Kampflogik (reines Lua, ohne Roblox-APIs -> testbar)
-- Seite 1 = links (läuft nach rechts), Seite 2 = rechts (läuft nach links).
-- Koordinaten in Spiel-Einheiten: x entlang des Schlachtfelds, y nach unten (negativ = Luft), z = Tiefe 0..34.

local Core = {}
Core.__index = Core

local function clamp(v, a, b)
	if v < a then return a elseif v > b then return b end
	return v
end
local function rand(a, b) return a + math.random() * (b - a) end
local function sign(x)
	if x < 0 then return -1 elseif x > 0 then return 1 end
	return 0
end

-- mode: "classic" | "waves" (Überleben) | "boss" (Boss-Ansturm) | "turbo"
function Core.new(Config, arenaIdx, fx, mode)
	local self = setmetatable({}, Core)
	self.mode = mode or "classic"
	self.wave = 0
	self.waveT = 8
	self.waveQueue = {}
	self.waveSpawnT = 0
	self.bossT = { 50, 50 }
	self.hill = { 0, 0 }
	self.heroes = {}    -- Besitzer -> Held (Besitzer = Spieler-ID oder "ai1"/"ai2")
	self.heroWant = {}  -- Besitzer -> { side, p }
	self.respawn = {}   -- Besitzer -> Zeitpunkt
	self.pig = { 5, 5 } -- Pigment-Raub: Farbe in jeder Burg
	self.score = { 0, 0 }
	self.hillOwner = 0
	self.HILL_X = Config.WORLD_W / 2
	self.HILL_R = 170
	self.C = Config
	self.W = Config.WORLD_W
	self.arenaIdx = arenaIdx
	self.arena = Config.ARENAS[arenaIdx]
	self.fx = fx or function() end
	self.units = {}
	self.projs = {}
	self.nextId = 0
	self.time = 0
	self.over = false
	self.result = nil
	self.gold = { 120, 120 }
	self.income = { 11, 11 }
	self.cmd = { "attack", "attack" }
	self.spawnCd = { {}, {} }
	self.abCd = { { meteor = 8, rage = 12, heal = 15 }, { meteor = 25, rage = 25, heal = 35 } }
	self.abLv = { { meteor = 1, rage = 1, heal = 1 }, { meteor = 1, rage = 1, heal = 1 } }
	self.rage = { 0, 0 }
	self.ai = { { on = true, save = 60, next = 2 }, { on = true, save = 80, next = 3 } }
	self.aiMul = { 1, 1 }
	self.bossDone = { false, false }
	self.boss = nil
	self.kills = {}
	self.sideKills = { 0, 0 }
	self.bases = {
		{ side = 1, x = 130, hp = 2400, maxHp = 2400, shoot = 0, tower = 0 },
		{ side = 2, x = self.W - 130, hp = 2400, maxHp = 2400, shoot = 0, tower = 0 },
	}
	self:configureSide(1, { ai = true })
	self:configureSide(2, { ai = true })
	return self
end

-- opts: ai (bool), tower (0..5), mine (0..5)
function Core:configureSide(side, opts)
	local d = self.arena.diff
	local b = self.bases[side]
	self.ai[side].on = opts.ai and true or false
	if opts.ai then
		b.maxHp = 2200 * (0.8 + d * 0.25)
		b.tower = math.max(0, math.floor(d * 1.5 + 0.5) - 1)
		self.income[side] = 10 * (0.85 + d * 0.25)
		self.aiMul[side] = 0.85 + d * 0.2
		self.abLv[side] = { meteor = d > 1.7 and 2 or 1, rage = 1, heal = 1 }
	else
		b.tower = opts.tower or 0
		b.maxHp = 2400 * (1 + b.tower * 0.15)
		self.income[side] = 11 + (opts.mine or 0) * 3
		self.aiMul[side] = 1
		if opts.ab then self.abLv[side] = opts.ab end
	end
	if self.mode == "turbo" then self.income[side] = self.income[side] * 2.2 end
	if self.mode == "boss" and opts.ai then self.income[side] = self.income[side] * 0.6 end
	if self.mode == "steal" then b.maxHp = b.maxHp * 2 end
	if self.mode == "sudden" then
		b.maxHp = b.maxHp * 0.35
		self.gold[side] = 350
	end
	if self.mode == "waves" and side == 2 then
		-- Wellen statt normaler KI, Burg unzerstörbar
		self.ai[2].on = false
		self.income[2] = 0
		b.maxHp = 999999
	end
	b.hp = b.maxHp
end

-- Steuerung mitten im Kampf wechseln (Spieler kommt/geht), ohne Burgleben zurückzusetzen
function Core:setControl(side, ai)
	self.ai[side].on = ai and true or false
end

function Core:other(side) return 3 - side end

function Core:aliveCount(side)
	local n = 0
	for _, u in ipairs(self.units) do
		if u.side == side and not u.dead then n = n + 1 end
	end
	return n
end

------------------------------------------------------------------ Spawnen
-- p: { tier = 1..5, helmet = "none", hpMul = 1, owner = userId }
function Core:canSpawn(side, type)
	local def = self.C.UNITS[type]
	if not def or self.over then return false, "over" end
	if self.gold[side] < def.cost then return false, "gold" end
	if (self.spawnCd[side][type] or 0) > 0 then return false, "cooldown" end
	if self:aliveCount(side) >= self.C.MAX_UNITS then return false, "full" end
	return true
end

function Core:spawn(side, type, p)
	p = p or {}
	local def = self.C.UNITS[type]
	if p.free then
		if self.over or not def or self:aliveCount(side) >= self.C.MAX_UNITS then return nil, "full" end
	else
		local ok, why = self:canSpawn(side, type)
		if not ok then return nil, why end
		self.gold[side] = self.gold[side] - def.cost
		self.spawnCd[side][type] = def.spawnCd * (self.mode == "turbo" and 0.5 or 1)
	end
	local tier, helmet, hpMul
	if self.ai[side].on and not p.owner and not p.tier then
		tier = clamp(self.arenaIdx, 1, 5)
		helmet = self.arenaIdx >= 4 and "knight" or "none"
		hpMul = self.aiMul[side]
	else
		tier = p.tier or 1
		helmet = p.helmet or "none"
		hpMul = p.hpMul or 1
	end
	local b = self.bases[side]
	local dir = self.C.SIDES[side].dir
	self.nextId = self.nextId + 1
	local u = {
		id = self.nextId, side = side, type = type, def = def, dir = dir,
		x = b.x + dir * 50, z = rand(0, 34), hp = def.hp * hpMul, maxHp = def.hp * hpMul,
		dmg = def.dmg * (1 + (tier - 1) * 0.28), tier = tier, helmet = helmet, owner = p.owner,
		state = "walk", atkT = 0, cdLeft = 0.3, kbx = 0, spawnT = 0.5, blockT = 0, cheer = 0,
		scale = def.scale, moving = false, combo = 0, attackN = 0, seed = math.random() * 100, skin = p.skin,
	}
	table.insert(self.units, u)
	self.fx("spawn", u)
	return u
end

function Core:spawnBoss(side)
	local g = self.C.UNITS.giant
	local d = self.arena.diff
	local def = {}
	for k, v in pairs(g) do def[k] = v end
	def.hp = g.hp * 4.5 * (0.8 + d * 0.2)
	def.speed = 34
	def.aoe = 110
	local b = self.bases[side]
	local dir = self.C.SIDES[side].dir
	self.nextId = self.nextId + 1
	local u = {
		id = self.nextId, side = side, type = "giant", def = def, dir = dir,
		x = b.x + dir * 60, z = 18, hp = def.hp, maxHp = def.hp, dmg = g.dmg * 1.5 * (1 + (self.arenaIdx - 1) * 0.2),
		tier = clamp(self.arenaIdx + 1, 2, 5), helmet = "crown", state = "walk", atkT = 0, cdLeft = 1, kbx = 0,
		spawnT = 0.5, blockT = 0, cheer = 1.2, scale = 2.35, moving = false, combo = 0, attackN = 0, seed = 7, boss = true,
	}
	table.insert(self.units, u)
	self.boss = u
	self.bossDone[side] = true
	self.fx("spawn", u)
	self.fx("announce", { text = "BOSS ERSCHEINT!", cls = "boss" })
	self.fx("shake", { amount = 1.2 })
end

------------------------------------------------------------------ Fähigkeiten
function Core:abilityCd(side, k)
	local lv = self.abLv[side][k] or 1
	return self.C.ABILITIES[k].cd * (1 - (lv - 1) * 0.08) * (self.mode == "turbo" and 0.5 or 1)
end

function Core:canUse(side, k)
	return (not self.over) and self.countdownLeft == nil and (self.abCd[side][k] or 0) <= 0
end

function Core:useAbility(side, k, x, caster)
	if not self:canUse(side, k) then return false end
	local lv = self.abLv[side][k] or 1
	self.abCd[side][k] = self:abilityCd(side, k)
	if k == "meteor" then
		x = clamp(tonumber(x) or self.W / 2, 80, self.W - 80)
		local dir = self.C.SIDES[side].dir
		local fromX = x - dir * 520
		local p = { meteor = true, x = fromX, y = -1100, z = 18, tz = 18, vx = (x - fromX) / 0.85, vy = 1100 / 0.85, g = 0,
			side = side, dmg = 150 * (1 + (lv - 1) * 0.35), tier = 5, life = 3, aoe = 135 + lv * 10, caster = caster }
		self:addProj(p)
	elseif k == "rage" then
		self.rage[side] = 6 + lv * 2
		for _, u in ipairs(self.units) do
			if u.side == side and not u.dead then u.cheer = 0.8 end
		end
		self.fx("ability", { side = side, k = "rage" })
	elseif k == "heal" then
		local pct = 0.25 + lv * 0.15
		local ids = {}
		for _, u in ipairs(self.units) do
			if u.side == side and not u.dead then
				u.hp = math.min(u.maxHp, u.hp + u.maxHp * pct)
				table.insert(ids, u.id)
			end
		end
		local b = self.bases[side]
		b.hp = math.min(b.maxHp, b.hp + b.maxHp * 0.06 * lv)
		self.fx("ability", { side = side, k = "heal", ids = ids })
	end
	return true
end

------------------------------------------------------------------ Hauptschleife
function Core:startCountdown(t) self.countdownLeft = t end

function Core:update(dt)
	if self.countdownLeft then
		self.countdownLeft = self.countdownLeft - dt
		if self.countdownLeft <= 0 then self.countdownLeft = nil end
		return
	end
	self.time = self.time + dt
	for s = 1, 2 do
		if not self.over then self.gold[s] = self.gold[s] + self.income[s] * dt end
		for k, v in pairs(self.spawnCd[s]) do self.spawnCd[s][k] = v - dt end
		for k, v in pairs(self.abCd[s]) do self.abCd[s][k] = v - dt end
		self.rage[s] = math.max(0, self.rage[s] - dt)
	end
	if not self.over then
		for s = 1, 2 do
			if self.ai[s].on then self:runAI(s, dt) end
			local b = self.bases[s]
			if self.mode ~= "boss" and self.ai[s].on and not self.bossDone[s] and not self.ai[3 - s].on and b.hp < b.maxHp * 0.55 then
				self:spawnBoss(s)
			end
			if self.mode == "boss" and self.ai[s].on then
				self.bossT[s] = self.bossT[s] - dt
				if self.bossT[s] <= 0 and not self.boss then
					self.bossT[s] = 45
					self:spawnBoss(s)
				end
			end
		end
		if self.mode == "waves" then self:updateWaves(dt) end
		if self.mode == "hill" then self:updateHill(dt) end
		-- Computer-Helden (außer im Überleben-Modus)
		for s = 1, 2 do
			local key = "ai" .. s
			if self.ai[s].on and self.mode ~= "waves" then
				if not self.heroWant[key] then self:wantHero(s, key, { ai = true, helmet = "crown", name = "CPU" }) end
			elseif self.heroWant[key] then
				self:dropHero(key)
			end
		end
		for owner, t in pairs(self.respawn) do
			if self.time >= t then self.respawn[owner] = nil; self:spawnHero(owner) end
		end
		if self.mode == "steal" then self:updateSteal(dt) end
		-- Verlängerung: nach 8 Minuten bröckeln beide Burgen, damit jede Runde endet
		if self.mode ~= "waves" and self.time > 480 then
			if not self.overtime then
				self.overtime = true
				self.fx("announce", { text = "VERLÄNGERUNG!", cls = "boss" })
			end
			for _, b in ipairs(self.bases) do b.hp = b.hp - b.maxHp * 0.008 * dt end
		end
	end
	for _, u in ipairs(self.units) do
		if not u.dead then self:updateUnit(u, dt) end
	end
	local keep = {}
	for _, u in ipairs(self.units) do
		if not u.dead then table.insert(keep, u) end
	end
	self.units = keep
	for _, b in ipairs(self.bases) do self:updateBase(b, dt) end
	self:updateProjs(dt)
	if not self.over then
		if self.bases[2].hp <= 0 then self:finish(1)
		elseif self.bases[1].hp <= 0 then self:finish(2) end
	end
end

------------------------------------------------------------------ Überleben (Wellen)
local WAVE_TYPES = { "sword", "sword", "spear", "archer", "shield", "ninja", "mage", "giant" }
function Core:updateWaves(dt)
	self.waveT = self.waveT - dt
	if self.waveT <= 0 then
		self.wave = self.wave + 1
		local w = self.wave
		self.waveT = 24
		local n = 3 + w * 2
		local maxIdx = math.min(#WAVE_TYPES, 3 + w)
		for i = 1, n do
			table.insert(self.waveQueue, WAVE_TYPES[math.random(1, maxIdx)])
		end
		if w % 5 == 0 then self.waveBoss = true end
		self.fx("announce", { text = "WELLE " .. w, cls = w % 5 == 0 and "boss" or "warn" })
		self.fx("wave", { wave = w })
	end
	self.waveSpawnT = self.waveSpawnT - dt
	if #self.waveQueue > 0 and self.waveSpawnT <= 0 then
		self.waveSpawnT = 0.45
		local t = table.remove(self.waveQueue, 1)
		local w = self.wave
		self:spawn(2, t, { free = true, tier = clamp(1 + math.floor(w / 3), 1, 5), helmet = w >= 6 and "knight" or "none", hpMul = 0.75 + w * 0.09 })
	elseif #self.waveQueue == 0 and self.waveBoss then
		self.waveBoss = false
		self:spawnBoss(2)
	end
end

------------------------------------------------------------------ Helden (selbst gesteuert)
function Core:wantHero(side, owner, p)
	local h = self.heroes[owner]
	if h and not h.dead and h.side ~= side then self:dropHero(owner) end
	self.heroWant[owner] = { side = side, p = p or {} }
	if not self.heroes[owner] and not self.respawn[owner] then self.respawn[owner] = self.time end
end

function Core:dropHero(owner)
	self.heroWant[owner] = nil
	self.respawn[owner] = nil
	local h = self.heroes[owner]
	if h and not h.dead then
		h.dead = true
		h.state = "dead"
		self:dropCarry(h)
		self.fx("death", { id = h.id, unit = h, dir = -h.dir, power = 0.5, cut = false })
	end
	self.heroes[owner] = nil
end

function Core:spawnHero(owner)
	local w = self.heroWant[owner]
	if not w or self.over then return end
	local side, p = w.side, w.p
	local def = self.C.UNITS.hero
	local tier, hpMul = p.tier or 1, p.hpMul or 1
	if p.ai then tier = clamp(self.arenaIdx, 1, 5); hpMul = self.aiMul[side] end
	local b = self.bases[side]
	local dir = self.C.SIDES[side].dir
	self.nextId = self.nextId + 1
	local u = {
		id = self.nextId, side = side, type = "sword", def = def, dir = dir, x = b.x + dir * 70, z = 17,
		hp = def.hp * hpMul, maxHp = def.hp * hpMul, dmg = def.dmg * (1 + (tier - 1) * 0.28), tier = tier,
		helmet = p.helmet or "none", owner = type(owner) == "number" and owner or nil, heroOwner = owner, hero = true,
		ai = p.ai == true, name = p.name, skin = p.skin,
		state = "walk", atkT = 0, cdLeft = 0.3, kbx = 0, spawnT = 0.5, blockT = 0, cheer = 0, scale = def.scale,
		moving = false, combo = 0, attackN = 0, seed = math.random() * 100, ctrl = { move = 0, atk = false, t = -1 },
	}
	table.insert(self.units, u)
	self.heroes[owner] = u
	self.fx("spawn", u)
end

function Core:heroInput(owner, move, atk)
	local h = self.heroes[owner]
	if not h or h.dead then return end
	h.ctrl.move = clamp(tonumber(move) or 0, -1, 1)
	h.ctrl.atk = atk == true
	h.ctrl.t = self.time
end

function Core:updateHeroHuman(u, dt, rm)
	local c = u.ctrl
	if self.time - c.t > 0.6 then c.move = 0; c.atk = false end
	if c.atk and u.cdLeft <= 0 then
		if c.move ~= 0 then u.dir = c.move end
		u.moving = false
		self:startAttack(u, { heroSwing = true, x = u.x + u.dir * 30 })
		return
	end
	if c.move ~= 0 then
		u.dir = c.move
		u.moving = true
		u.x = clamp(u.x + c.move * u.def.speed * rm * (u.carry and 0.75 or 1) * dt, 40, self.W - 40)
	else
		u.moving = false
	end
end

-- Held schlägt alles vor sich (bis zu 4 Gegner), jeder 3. Schlag schleudert weg
function Core:heroHit(u)
	local reach = u.def.range + 25
	local hits = 0
	local heavy = u.combo % 3 == 2
	for _, e in ipairs(self.units) do
		if hits < 4 and e.side ~= u.side and not e.dead and (e.x - u.x) * u.dir > -10 and math.abs(e.x - u.x) < reach * (e.scale > 1.5 and 1.3 or 1) then
			self:damage(e, u.dmg, u, heavy, false)
			hits = hits + 1
		end
	end
	local eb = self.bases[3 - u.side]
	if math.abs(eb.x - u.x) < reach + 46 then self:damageBase(eb, u.dmg * 0.8, u) end
	if heavy then self.fx("slam", { x = u.x + u.dir * 30, z = u.z, r = 50 }) end
end

------------------------------------------------------------------ Pigment-Raub
function Core:dropCarry(h)
	if not h.carry then return end
	h.carry = false
	self.pig[3 - h.side] = self.pig[3 - h.side] + 1
	if not self.over then self.fx("announce", { text = "PIGMENT ZURÜCK!", cls = "ok" }) end
end

function Core:updateSteal(dt)
	for _, h in pairs(self.heroes) do
		if not h.dead and h.spawnT <= 0 and not self.over then
			local es, hb, eb = 3 - h.side, self.bases[h.side], self.bases[3 - h.side]
			if not h.carry then
				if math.abs(h.x - eb.x) < 95 and self.pig[es] > 0 then
					h.stealT = (h.stealT or 0) + dt
					if h.stealT >= 1.5 then
						h.stealT = 0
						h.carry = true
						self.pig[es] = self.pig[es] - 1
						self.fx("announce", { text = "PIGMENT GEKLAUT!", cls = "warn" })
					end
				else
					h.stealT = 0
				end
			elseif math.abs(h.x - hb.x) < 95 then
				h.carry = false
				self.score[h.side] = self.score[h.side] + 1
				self.fx("announce", { text = "PUNKT!", cls = "ok" })
				if self.score[h.side] >= 3 then self:finish(h.side); return end
			end
		end
	end
end

------------------------------------------------------------------ Hügel-König
function Core:updateHill(dt)
	local c = { 0, 0 }
	for _, u in ipairs(self.units) do
		if not u.dead and math.abs(u.x - self.HILL_X) < self.HILL_R then c[u.side] = c[u.side] + 1 end
	end
	local owner = 0
	if c[1] > 0 and c[2] == 0 then owner = 1 elseif c[2] > 0 and c[1] == 0 then owner = 2 end
	if owner ~= 0 then
		self.hill[owner] = self.hill[owner] + dt * (1.2 + 0.12 * math.min(c[owner], 10))
		if self.hill[owner] >= 100 then self.hill[owner] = 100; self:finish(owner); return end
	end
	if owner ~= self.hillOwner then
		self.hillOwner = owner
		if owner ~= 0 then self.fx("announce", { text = "HÜGEL EROBERT!", cls = "warn", side = owner }) end
	end
end

function Core:finish(winner)
	self.over = true
	self.result = winner
	self.fx("over", { winner = winner, x = self.bases[3 - winner].x })
	for _, u in ipairs(self.units) do
		if not u.dead then
			if u.side == winner then u.victory = true
			else self:kill(u, self.C.SIDES[winner].dir, true, nil) end
		end
	end
end

------------------------------------------------------------------ KI
function Core:runAI(side, dt)
	local ai = self.ai[side]
	ai.next = ai.next - dt
	if ai.next > 0 then return end
	ai.next = rand(0.4, 1.0)
	local g = self.gold[side]
	local foes, mine = {}, {}
	for _, u in ipairs(self.units) do
		if not u.dead then
			if u.side == side then table.insert(mine, u) else table.insert(foes, u) end
		end
	end
	local home = self.bases[side].x
	local threat = 0
	for _, f in ipairs(foes) do if math.abs(f.x - home) < 700 then threat = threat + 1 end end
	-- Fähigkeiten
	if self.arena.diff >= 1.3 and #foes >= 4 and self:canUse(side, "meteor") then
		local best, bc = nil, 0
		for _, f in ipairs(foes) do
			local c = 0
			for _, o in ipairs(foes) do if math.abs(o.x - f.x) < 110 then c = c + 1 end end
			if c > bc then bc = c; best = f end
		end
		local friendly = false
		if best then for _, m in ipairs(mine) do if math.abs(m.x - best.x) < 90 then friendly = true end end end
		if best and bc >= 4 and not friendly then self:useAbility(side, "meteor", best.x) end
	end
	if #mine >= 7 and self:canUse(side, "rage") and math.random() < 0.3 then self:useAbility(side, "rage") end
	if self:canUse(side, "heal") then
		local hurt = 0
		for _, m in ipairs(mine) do if m.hp < m.maxHp * 0.45 then hurt = hurt + 1 end end
		if hurt >= 4 then self:useAbility(side, "heal") end
	end
	if g < ai.save and threat < 3 then return end
	local cnt = {}
	for _, f in ipairs(foes) do cnt[f.type] = (cnt[f.type] or 0) + 1 end
	local function c(t) return cnt[t] or 0 end
	local archers = 0
	for _, m in ipairs(mine) do if m.type == "archer" then archers = archers + 1 end end
	local w = {
		sword = 4, spear = 3 + c("giant") * 3, archer = archers > 6 and 0.5 or (3 + c("sword") * 0.5),
		shield = 1.5 + c("archer") * 1.2, ninja = 2 + c("archer") * 1.5 + c("mage") * 1.5,
		mage = 1.5 + c("shield") * 1.5 + c("sword") * 0.4, giant = (g > 220 and 3 or 0.5) + c("sword") * 0.6,
	}
	local tot = 0
	for _, t in ipairs(self.C.UNIT_ORDER) do tot = tot + w[t] end
	local r = math.random() * tot
	local choice = "sword"
	for _, t in ipairs(self.C.UNIT_ORDER) do
		r = r - w[t]
		if r <= 0 then choice = t; break end
	end
	if not self:spawn(side, choice) then
		if g > 40 then self:spawn(side, "sword") end
	elseif self.gold[side] < 30 then
		ai.save = rand(60, 260)
	end
end

------------------------------------------------------------------ Einheiten
function Core:updateUnit(u, dt)
	local rm = self.rage[u.side] > 0 and 1.45 or 1
	u.rage = rm > 1
	u.cdLeft = u.cdLeft - dt * rm
	u.spawnT = math.max(0, u.spawnT - dt)
	u.blockT = math.max(0, u.blockT - dt)
	u.cheer = math.max(0, u.cheer - dt)
	if u.spawnT > 0 then u.moving = false; return end
	if u.cheer > 0 and u.state ~= "attack" then u.moving = false; return end
	if math.abs(u.kbx) > 2 then
		u.x = u.x + u.kbx * dt
		u.kbx = u.kbx * (0.004 ^ dt)
	end
	u.x = clamp(u.x, 40, self.W - 40)
	if u.victory then u.moving = false; return end

	if u.state == "attack" then
		u.atkT = u.atkT + dt * rm / u.atkDur
		if not u.hitDone and u.atkT >= u.hitAt then
			u.hitDone = true
			self:doHit(u)
		end
		if u.atkT >= 1 then
			u.state = "idle"
			u.combo = u.combo + 1
		end
		u.moving = false
		return
	end

	if u.hero and not u.ai then self:updateHeroHuman(u, dt, rm); return end

	local def = u.def
	local target = self:findTarget(u)
	local eb = self.bases[3 - u.side]
	local goal = nil
	-- Computer-Held im Pigment-Raub: mit Beute direkt nach Hause, sonst zur feindlichen Burg
	if u.hero and self.mode == "steal" then
		if u.carry then target = nil end
		-- nur kämpfen, wenn der Gegner direkt im Weg steht
		if target and not target.isBase and math.abs(target.x - u.x) > 55 then target = nil end
		if not target then
			goal = u.carry and self.bases[u.side].x or eb.x
			local d = goal > u.x and 1 or -1
			if math.abs(goal - u.x) > 20 then
				u.dir = d; u.moving = true
				u.x = u.x + d * def.speed * rm * (u.carry and 0.75 or 1) * dt
			else
				u.moving = false
			end
			return
		end
	end
	if target then
		local dist = math.abs(target.x - u.x) - (target.isBase and 46 or 0)
		if dist <= def.range then
			u.moving = false
			u.dir = target.x >= u.x and 1 or -1
			if u.cdLeft <= 0 then self:startAttack(u, target) end
			return
		end
		goal = target.x
	end
	if goal == nil then
		if self.cmd[u.side] == "defend" then
			local home = self.C.SIDES[u.side].dir
			local rally = self.bases[u.side].x + home * (260 + (u.seed % 1) * 60 + (def.ranged and -60 or 0))
			if math.abs(rally - u.x) > 12 then goal = rally end
		else
			goal = eb.x
		end
	end
	if goal == nil then
		u.moving = false
		u.dir = self.C.SIDES[u.side].dir
		return
	end
	local d = goal > u.x and 1 or -1
	u.dir = d
	u.moving = true
	u.x = u.x + d * def.speed * rm * dt
end

function Core:findTarget(u)
	local def = u.def
	local aggro = def.ranged and (def.range + 30) or 260
	local best, bd = nil, 1e9
	local defending = self.cmd[u.side] == "defend"
	local home = self.bases[u.side].x
	local fwd = self.C.SIDES[u.side].dir
	for _, e in ipairs(self.units) do
		if e.side ~= u.side and not e.dead then
			local d = math.abs(e.x - u.x)
			if d <= aggro and not (defending and math.abs(e.x - home) > 560) then
				local score = d + (sign(e.x - u.x) ~= fwd and 40 or 0)
				if score < bd then bd = score; best = e end
			end
		end
	end
	if best then return best end
	local eb = self.bases[3 - u.side]
	if math.abs(eb.x - u.x) < def.range + 50 + (def.ranged and 0 or 10) then
		return { isBase = true, x = eb.x, base = eb }
	end
	return nil
end

function Core:startAttack(u, t)
	u.state = "attack"
	u.atkT = 0
	u.hitDone = false
	u.target = t
	u.atkDur = u.def.atk * (1 - (u.tier - 1) * 0.04)
	u.hitAt = self.C.HIT_AT[u.type]
	u.cdLeft = u.def.cd * (1 - (u.tier - 1) * 0.05) + rand(0, 0.15)
	u.attackN = u.attackN + 1
	self.fx("attack", u)
end

-- ungefähre Position der Waffenhand (für Projektile)
local function handPos(u)
	return u.x + u.dir * 14 * u.scale, -50 * u.scale
end

function Core:doHit(u)
	if u.hero then self:heroHit(u); return end
	local t = u.target
	if not t then return end
	if u.type == "mage" or u.type == "archer" then
		if not t.isBase and t.dead then return end
		local sx, sy = handPos(u)
		if u.type == "mage" then sy = -78 * u.scale end
		local tx
		if t.isBase then tx = t.x else tx = t.x + (t.moving and t.dir * t.def.speed * (u.type == "mage" and 0.5 or 0.6) or 0) end
		tx = tx + rand(-10, 10)
		local mage = u.type == "mage"
		local T = clamp(math.abs(tx - sx) / (mage and 380 or 520), mage and 0.4 or 0.35, mage and 1.0 or 1.1)
		local gr = mage and 500 or 900
		local ty = t.isBase and -70 or (mage and -30 or -40 * (t.scale or 1))
		self:addProj({
			orb = mage, x = sx, y = sy, z = u.z, tz = t.isBase and u.z or t.z,
			vx = (tx - sx) / T, vy = (ty - sy - 0.5 * gr * T * T) / T, g = gr,
			side = u.side, dmg = u.dmg, tier = u.tier, life = 4, owner = u, aoe = mage and u.def.aoe or nil,
		})
		return
	end
	local reach = u.def.range + 22
	if u.type == "giant" then
		local hx = u.x + u.dir * 44 * u.scale
		self.fx("slam", { x = hx, z = u.z, r = u.def.aoe, boss = u.boss })
		local victims = {}
		for _, e in ipairs(self.units) do
			if e.side ~= u.side and not e.dead and math.abs(e.x - hx) < u.def.aoe then table.insert(victims, e) end
		end
		for _, e in ipairs(victims) do self:damage(e, u.dmg, u, true, false) end
		local eb = self.bases[3 - u.side]
		if math.abs(eb.x - hx) < u.def.aoe + 40 then self:damageBase(eb, u.dmg * 1.2, u) end
		return
	end
	if t.isBase then self:damageBase(t.base, u.dmg, u); return end
	if t.dead or math.abs(t.x - u.x) > reach then return end
	-- Parade
	if t.state == "attack" and t.type ~= "archer" and math.random() < 0.18 then
		self.fx("clash", { x = (u.x + t.x) / 2, y = -40 * u.scale, z = u.z })
		self:damage(t, u.dmg * 0.3, u, false, false)
		return
	end
	local heavy = u.type == "spear" or (u.type == "ninja" and u.combo % 4 == 3)
	self:damage(t, u.dmg, u, heavy, false)
end

-- src: Einheit oder { x, side, tier, aoe, owner }
function Core:damage(e, amount, src, heavy, proj)
	if e.dead then return end
	amount = amount * rand(0.88, 1.12)
	if self.mode == "sudden" then amount = amount * 1.5 end
	if src and src.side and self.rage[src.side] > 0 then amount = amount * 1.4 end
	local dir = -e.dir
	if src and src.x then dir = (e.x >= src.x) and 1 or -1 end
	if e.type == "shield" and not (src and src.aoe) and e.dir == -dir and e.state ~= "attack" then
		amount = amount * (proj and 0.25 or 0.45)
		e.blockT = 0.3
		e.kbx = e.kbx + dir * 40
		e.hp = e.hp - amount
		self.fx("hit", { id = e.id, x = e.x, y = -40 * e.scale, z = e.z, side = e.side, amount = amount, dir = dir, blocked = true, src = src and src.side })
		if e.hp <= 0 then self:kill(e, dir, false, src) end
		return
	end
	local crit = math.random() < 0.1
	if crit then amount = amount * 1.8 end
	e.hp = e.hp - amount
	e.kbx = e.kbx + dir * (heavy and 260 or 90) / e.scale
	if e.state == "attack" and heavy then e.state = "idle" end
	self.fx("hit", { id = e.id, x = e.x, y = -38 * e.scale, z = e.z, side = e.side, amount = amount, dir = dir, heavy = heavy, crit = crit, tier = src and src.tier, src = src and src.side })
	if e.hp <= 0 then self:kill(e, dir, heavy or crit, src) end
end

function Core:kill(e, dir, heavy, src)
	if e.dead then return end
	e.dead = true
	e.state = "dead"
	local power = heavy and rand(1.0, 1.5) or rand(0.4, 0.7)
	local cut = false -- keine abfliegenden Köpfe (kinderfreundlich)
	if e.hero then
		power = power * 1.4
		if self.heroes[e.heroOwner] == e then self.heroes[e.heroOwner] = nil end
		if self.heroWant[e.heroOwner] then self.respawn[e.heroOwner] = self.time + 6 end
		self:dropCarry(e)
	end
	if e.boss then
		e.boss = false
		self.boss = nil
		if not self.over then
			self.fx("announce", { text = "BOSS BESIEGT!", cls = "ok" })
			self.fx("shake", { amount = 1.5 })
		end
	end
	local owner = src and src.owner
	if type(owner) == "table" then owner = owner.owner end
	if owner and not self.over then self.kills[owner] = (self.kills[owner] or 0) + 1 end
	if not self.over and src and src.side then self.sideKills[src.side] = self.sideKills[src.side] + 1 end
	self.fx("death", { id = e.id, unit = e, dir = dir, power = power, cut = cut, owner = owner })
end

------------------------------------------------------------------ Explosion / Basis
function Core:explode(x, z, radius, dmg, side, big, owner)
	self.fx("explode", { x = x, z = z, r = radius, big = big, side = side })
	local victims = {}
	for _, e in ipairs(self.units) do
		if e.side ~= side and not e.dead and math.abs(e.x - x) < radius then table.insert(victims, e) end
	end
	for _, e in ipairs(victims) do
		local d = math.abs(e.x - x)
		self:damage(e, dmg * (1 - d / radius * 0.5), { x = x, side = side, tier = 5, aoe = true, owner = owner }, true, false)
	end
	local eb = self.bases[3 - side]
	if math.abs(eb.x - x) < radius + 40 then self:damageBase(eb, dmg * (big and 0.8 or 0.5), nil) end
	return #victims
end

function Core:damageBase(b, amount, src)
	if self.over then return end
	if self.mode == "waves" and b.side == 2 then return end
	b.hp = b.hp - amount
	self.fx("base", { side = b.side, amount = amount, x = b.x })
end

function Core:updateBase(b, dt)
	if self.over or b.hp <= 0 then return end
	b.shoot = b.shoot - dt
	if b.shoot > 0 then return end
	local range = 430 + b.tower * 40
	local best, bd = nil, 1e9
	for _, e in ipairs(self.units) do
		if e.side ~= b.side and not e.dead then
			local d = math.abs(e.x - b.x)
			if d < range and d < bd then bd = d; best = e end
		end
	end
	if not best then b.shoot = 0.3; return end
	b.shoot = math.max(0.7, 2.2 - b.tower * 0.3)
	local sx = b.x + (b.side == 1 and 20 or -20)
	local sy = -190
	local tx = best.x + (best.moving and best.dir * best.def.speed * 0.5 or 0)
	local T, g = 0.8, 900
	self:addProj({ x = sx, y = sy, z = best.z, tz = best.z, vx = (tx - sx) / T, vy = (-40 - sy - 0.5 * g * T * T) / T, g = g,
		side = b.side, dmg = 22 + b.tower * 10, tier = clamp(b.tower + 1, 1, 5), life = 4, bolt = true })
end

------------------------------------------------------------------ Projektile
function Core:addProj(p)
	self.nextId = self.nextId + 1
	p.id = self.nextId
	table.insert(self.projs, p)
	self.fx("proj", p)
end

function Core:updateProjs(dt)
	local keep = {}
	for _, p in ipairs(self.projs) do
		p.vy = p.vy + p.g * dt
		p.x = p.x + p.vx * dt
		p.y = p.y + p.vy * dt
		p.z = p.z + (p.tz - p.z) * math.min(1, dt * 3)
		p.life = p.life - dt
		local done = false
		if p.meteor then
			if p.y >= 0 then
				self:explode(p.x, p.z, p.aoe, p.dmg, p.side, true, p.caster)
				self.fx("shake", { amount = 2 })
				done = true
			end
		elseif p.orb then
			local hit = p.y >= 0
			for _, e in ipairs(self.units) do
				if not hit and e.side ~= p.side and not e.dead and math.abs(e.x - p.x) < 12 * e.scale and p.y > -70 * e.scale then hit = true end
			end
			local eb = self.bases[3 - p.side]
			if math.abs(eb.x - p.x) < 44 and p.y > -230 then hit = true end
			if hit then
				self:explode(p.x, p.z, p.aoe, p.dmg, p.side, false, p.owner and p.owner.owner)
				done = true
			end
		else
			for _, e in ipairs(self.units) do
				if not done and e.side ~= p.side and not e.dead then
					local h = 70 * e.scale
					if math.abs(e.x - p.x) < 10 * e.scale + 4 and p.y > -h and p.y < 2 then
						local src = p.owner or { x = p.x - sign(p.vx), side = p.side, tier = p.tier }
						self:damage(e, p.dmg, src, false, true)
						done = true
					end
				end
			end
			if not done then
				local eb = self.bases[3 - p.side]
				if math.abs(eb.x - p.x) < 44 and p.y > -230 then
					self:damageBase(eb, p.dmg * 0.8, p.owner)
					done = true
				elseif p.y >= 0 then
					done = true
				end
			end
		end
		if p.life <= 0 then done = true end
		if done then
			self.fx("projEnd", { id = p.id, x = p.x, y = math.min(p.y, 0), z = p.z })
		else
			table.insert(keep, p)
		end
	end
	self.projs = keep
end

return Core
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Spielerdaten: Münzen, Helme, Waffenstufen. Speichert per DataStore.
-- Läuft auch in Roblox Studio ohne API-Zugriff (dann nur für die aktuelle Sitzung).
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("PK"):WaitForChild("Config"))

local Data = {}
local cache = {}
local store = nil
local okStore = pcall(function()
	store = DataStoreService:GetDataStore("PigmentKrieg_v1")
end)
if not okStore then store = nil end

local function merge(d)
	local base = Config.newData()
	if type(d) ~= "table" then return base end
	for k, v in pairs(base) do
		if d[k] == nil then d[k] = v end
	end
	for k, v in pairs(base.wlv) do if d.wlv[k] == nil then d.wlv[k] = v end end
	for k, v in pairs(base.ab) do if d.ab[k] == nil then d.ab[k] = v end end
	d.owned.none = true
	return d
end

function Data.publish(player)
	local d = cache[player]
	if d then player:SetAttribute("Data", HttpService:JSONEncode(d)) end
end

function Data.load(player)
	local d = nil
	if store then
		local ok, res = pcall(function() return store:GetAsync("p_" .. player.UserId) end)
		if ok then d = res; Data.storeWorks = true
		else
			Data.storeWorks = false warn("[PigmentKrieg] DataStore nicht erreichbar (in Studio: Game Settings > Security > API Services). Fortschritt wird nicht gespeichert.") end
	end
	cache[player] = merge(d)
	Data.publish(player)
	return cache[player]
end

function Data.get(player) return cache[player] end

function Data.save(player)
	local d = cache[player]
	if not d or not store then return end
	pcall(function() store:SetAsync("p_" .. player.UserId, d) end)
end

function Data.release(player)
	Data.save(player)
	cache[player] = nil
end

function Data.saveAll()
	for p in pairs(cache) do Data.save(p) end
end

-- Käufe ------------------------------------------------------------
local function helmetById(id)
	for _, h in ipairs(Config.HELMETS) do if h.id == id then return h end end
	return nil
end

function Data.buyHelmet(player, id)
	local d, h = cache[player], helmetById(id)
	if not d or not h then return false end
	if h.pass and not player:GetAttribute("Pass_" .. h.pass) then return false end
	if not d.owned[id] then
		if d.coins < h.price then return false end
		d.coins = d.coins - h.price
		d.owned[id] = true
	end
	d.helmet = id
	Data.publish(player)
	return true
end

function Data.upgradeWeapon(player, t)
	local d = cache[player]
	if not d or not Config.UNITS[t] then return false end
	local lv = d.wlv[t]
	if lv >= 5 then return false end
	local cost = Config.UPGRADE_COST[lv]
	if d.coins < cost then return false end
	d.coins = d.coins - cost
	d.wlv[t] = lv + 1
	Data.publish(player)
	return true
end

function Data.upgradeAbility(player, k)
	local d = cache[player]
	if not d or not Config.ABILITIES[k] then return false end
	local lv = d.ab[k]
	if lv >= 3 then return false end
	local cost = Config.ABILITY_COST[lv]
	if d.coins < cost then return false end
	d.coins = d.coins - cost
	d.ab[k] = lv + 1
	Data.publish(player)
	return true
end

function Data.upgradeExtra(player, id)
	local d = cache[player]
	if not d then return false end
	for _, x in ipairs(Config.EXTRAS) do
		if x.id == id then
			local lv = d[id]
			if lv >= x.max then return false end
			local cost = Config.extraCost(x, lv)
			if d.coins < cost then return false end
			d.coins = d.coins - cost
			d[id] = lv + 1
			Data.publish(player)
			return true
		end
	end
	return false
end

function Data.reward(player, coins, won, kills)
	local d = cache[player]
	if not d then return end
	d.coins = d.coins + coins
	d.games = d.games + 1
	d.kills = d.kills + kills
	if won then d.wins = d.wins + 1 end
	Data.publish(player)
	task.spawn(Data.save, player)
end

-- Robux-Kauf gutschreiben (einmal pro Kauf-ID). Gibt true zurück, wenn gespeichert.
function Data.grantProduct(player, key, purchaseId)
	local d = cache[player]
	local prod = Config.PRODUCTS[key]
	if not d or not prod then return false end
	d.receipts = d.receipts or {}
	if d.receipts[purchaseId] then return true end
	if prod.coins then d.coins = d.coins + prod.coins end
	if prod.helmet then d.owned[prod.helmet] = true; d.helmet = prod.helmet end
	d.receipts[purchaseId] = true
	Data.publish(player)
	-- In Studio ohne Speicherzugriff gilt der Kauf nur für diese Sitzung
	if store and Data.storeWorks ~= false then
		local ok = pcall(function() store:SetAsync("p_" .. player.UserId, d) end)
		return ok
	end
	return true
end

function Data.setBestWave(player, w)
	local d = cache[player]
	if d and w > (d.bestWave or 0) then d.bestWave = w; Data.publish(player) end
end

-- Tägliche Belohnung: gibt { coins, streak } zurück oder nil, wenn heute schon abgeholt
function Data.daily(player)
	local d = cache[player]
	if not d then return nil end
	local today = math.floor(os.time() / 86400)
	if (d.lastDaily or 0) >= today then return nil end
	if (d.lastDaily or 0) == today - 1 then d.streak = math.min((d.streak or 0) + 1, 7) else d.streak = 1 end
	d.lastDaily = today
	local coins = 75 + d.streak * 25
	d.coins = d.coins + coins
	Data.publish(player)
	return { coins = coins, streak = d.streak }
end

-- Autosave
task.spawn(function()
	while true do
		task.wait(90)
		Data.saveAll()
	end
end)
if not RunService:IsStudio() then
	game:BindToClose(function() Data.saveAll() end)
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">Arena</string><ProtectedString name="Source"><![CDATA[-- Baut die Arena (Boden, Berge, Deko, Burgen) und das Licht.
local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("PK"):WaitForChild("Config"))

local Arena = {}
local K = Config.K
local folder = nil
local towers = {}

local function rgb(t) return Color3.fromRGB(t[1], t[2], t[3]) end
local function shade(c, k) return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1)) end

local function part(props)
	local p = Instance.new(props.Shape and "Part" or (props.Class or "Part"))
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	for k, v in pairs(props) do
		if k ~= "Class" and k ~= "Material" and k ~= "Parent" then p[k] = v end
	end
	p.Parent = props.Parent or folder
	return p
end

local function setLighting(a)
	Lighting.ClockTime = a.clock
	Lighting.Brightness = a.id == "neon" and 1 or 2.2
	Lighting.Ambient = shade(rgb(a.fog), 0.45)
	Lighting.OutdoorAmbient = shade(rgb(a.fog), 0.7)
	Lighting.FogColor = rgb(a.fog)
	Lighting.FogStart = 60
	Lighting.FogEnd = 260
	Lighting.GlobalShadows = true
	local atm = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atm.Density = 0.32
	atm.Offset = 0.1
	atm.Color = rgb(a.fog)
	atm.Decay = rgb(a.sky)
	atm.Glare = a.id == "volcano" and 2 or 0.5
	atm.Haze = 1.5
	atm.Parent = Lighting
	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Contrast = 0.12
	cc.Saturation = a.id == "plains" and -0.15 or 0.05
	cc.Parent = Lighting
end

local function buildTower(side)
	local S = Config.SIDES[side]
	local col = rgb(S.color)
	local rimCol = side == 1 and Color3.fromRGB(60, 60, 66) or Color3.fromRGB(200, 200, 194)
	local x = (side == 1 and 130 or Config.WORLD_W - 130) * K
	local m = Instance.new("Model")
	m.Name = "Burg" .. side
	m.Parent = folder
	local function p(size, pos, color, mat)
		return part({ Size = size, CFrame = CFrame.new(x + pos.X, pos.Y, pos.Z), Color = color or col, Material = mat, Parent = m })
	end
	p(Vector3.new(11, 1, 9), Vector3.new(0, 0.5, -1), rimCol)
	p(Vector3.new(9.5, 7, 7.5), Vector3.new(0, 4, -1))
	p(Vector3.new(7.6, 15, 6), Vector3.new(0, 14.5, -1))
	p(Vector3.new(9.6, 1.6, 7.6), Vector3.new(0, 22.6, -1), rimCol)
	for i = -1, 1, 2 do
		for j = -1, 1, 2 do
			p(Vector3.new(2, 1.8, 2), Vector3.new(i * 3.6, 24.3, -1 + j * 2.8))
		end
	end
	-- Tor und Fenster zur Kamera
	local dark = side == 1 and Color3.fromRGB(40, 40, 46) or Color3.fromRGB(170, 170, 162)
	p(Vector3.new(3, 4.4, 0.3), Vector3.new(0, 2.6, 2.8), dark)
	local winCol = side == 1 and Color3.fromRGB(255, 207, 90) or Color3.fromRGB(70, 50, 20)
	p(Vector3.new(1.2, 2.2, 0.3), Vector3.new(0, 14, 2.05), winCol, side == 1 and Enum.Material.Neon or nil)
	p(Vector3.new(1.2, 1.8, 0.3), Vector3.new(0, 10.4, 2.05), winCol, side == 1 and Enum.Material.Neon or nil)
	-- Fahne
	p(Vector3.new(0.3, 7, 0.3), Vector3.new(0, 28.5, -1), Color3.fromRGB(80, 80, 80))
	local dir = S.dir
	p(Vector3.new(5, 2.6, 0.15), Vector3.new(dir * 2.6, 30.4, -1), col)
	towers[side] = m
end

function Arena.build(idx)
	if folder then folder:Destroy() end
	towers = {}
	folder = Instance.new("Folder")
	folder.Name = "PKArena"
	folder.Parent = workspace
	local a = Config.ARENAS[idx]
	setLighting(a)
	local W = Config.WORLD_W * K
	local g = rgb(a.ground)
	part({ Size = Vector3.new(W + 400, 6, 140), CFrame = CFrame.new(W / 2, -3, -20), Color = g, Material = Enum.Material.Ground, CanCollide = true })
	part({ Size = Vector3.new(W + 400, 0.2, 7), CFrame = CFrame.new(W / 2, -0.09, 0), Color = shade(g, 0.88), Material = Enum.Material.Sand })
	-- Berge im Hintergrund
	local rnd = Random.new(idx * 977 + 13)
	local far = rgb(a.far)
	for i = -6, 40 do
		local h = rnd:NextNumber(18, 48)
		local w = rnd:NextNumber(16, 30)
		local z = rnd:NextNumber(-95, -70)
		local cx = i * 9
		local wedge = part({ Class = "WedgePart", Size = Vector3.new(4, h, w / 2), Color = shade(far, rnd:NextNumber(0.85, 1.1)), Material = Enum.Material.Slate })
		wedge.CFrame = CFrame.new(cx - w / 4, h / 2, z) * CFrame.Angles(0, math.rad(90), 0)
		local wedge2 = part({ Class = "WedgePart", Size = Vector3.new(4, h, w / 2), Color = wedge.Color, Material = Enum.Material.Slate })
		wedge2.CFrame = CFrame.new(cx + w / 4, h / 2, z) * CFrame.Angles(0, math.rad(-90), 0)
	end
	-- Deko je Arena
	for i = 1, 26 do
		local x = rnd:NextNumber(30, W - 30)
		local z = rnd:NextNumber(-30, -8)
		if a.id == "plains" then
			part({ Size = Vector3.new(rnd:NextNumber(2, 5), rnd:NextNumber(1.5, 3.5), rnd:NextNumber(2, 4)), CFrame = CFrame.new(x, 0.8, z) * CFrame.Angles(0, rnd:NextNumber(0, 6), 0.2), Color = shade(g, 0.8), Material = Enum.Material.Rock })
		elseif a.id == "volcano" then
			part({ Class = "WedgePart", Size = Vector3.new(2, rnd:NextNumber(4, 9), 3), CFrame = CFrame.new(x, 2.5, z), Color = Color3.fromRGB(40, 25, 22), Material = Enum.Material.Basalt })
			if i % 3 == 0 then
				local lava = part({ Size = Vector3.new(rnd:NextNumber(4, 8), 0.2, rnd:NextNumber(2, 4)), CFrame = CFrame.new(x, 0.1, z + 4), Color = Color3.fromRGB(255, 110, 30), Material = Enum.Material.Neon })
				local l = Instance.new("PointLight"); l.Color = lava.Color; l.Range = 14; l.Brightness = 2; l.Parent = lava
			end
		elseif a.id == "ice" then
			part({ Size = Vector3.new(1.2, rnd:NextNumber(3, 6), 1.2), CFrame = CFrame.new(x, 2, z) * CFrame.Angles(0, 0.7, rnd:NextNumber(-0.3, 0.3)), Color = Color3.fromRGB(200, 235, 255), Material = Enum.Material.Ice, Transparency = 0.2 })
		elseif a.id == "neon" then
			if i % 2 == 0 then
				part({ Size = Vector3.new(1.6, 16, 1.6), CFrame = CFrame.new(x, 8, z), Color = Color3.fromRGB(26, 18, 48) })
				local top = part({ Size = Vector3.new(2, 0.5, 2), CFrame = CFrame.new(x, 16.2, z), Color = (i % 4 == 0) and Color3.fromRGB(255, 79, 216) or Color3.fromRGB(70, 230, 255), Material = Enum.Material.Neon })
				local l = Instance.new("PointLight"); l.Color = top.Color; l.Range = 22; l.Brightness = 3; l.Parent = top
			end
		elseif a.id == "temple" then
			if i % 2 == 0 then
				part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(14, 2.2, 2.2), CFrame = CFrame.new(x, 7, z) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(170, 135, 80), Material = Enum.Material.Marble })
				part({ Size = Vector3.new(3.2, 0.8, 3.2), CFrame = CFrame.new(x, 14.3, z), Color = Color3.fromRGB(150, 118, 70), Material = Enum.Material.Marble })
			end
		end
	end
	if a.id == "neon" then
		for i = 0, math.floor(W / 10) do
			part({ Size = Vector3.new(0.15, 0.05, 40), CFrame = CFrame.new(i * 10, 0.03, 8), Color = Color3.fromRGB(255, 79, 216), Material = Enum.Material.Neon, Transparency = 0.5 })
		end
	end
	buildTower(1)
	buildTower(2)
end

-- Burg stürzt ein
function Arena.collapse(side)
	local m = towers[side]
	if not m then return end
	local rnd = Random.new()
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = true
			p.Anchored = false
			p.AssemblyLinearVelocity = Vector3.new(rnd:NextNumber(-30, 30), rnd:NextNumber(5, 40), rnd:NextNumber(-10, 25))
			p.AssemblyAngularVelocity = Vector3.new(rnd:NextNumber(-4, 4), rnd:NextNumber(-4, 4), rnd:NextNumber(-4, 4))
		end
	end
end

return Arena
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">Rooms</string><ProtectedString name="Source"><![CDATA[-- Private Räume: Ein Spieler erstellt einen Raum mit Code, Freunde treten mit dem Code bei.
-- Technisch: ein reservierter Server (TeleportService) + Code-Tabelle im MemoryStore (über alle Server hinweg).
local TeleportService = game:GetService("TeleportService")
local MemoryStoreService = game:GetService("MemoryStoreService")

local Rooms = {}
local map = nil
pcall(function() map = MemoryStoreService:GetSortedMap("PK_Rooms_v1") end)

local LETTERS = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789" -- ohne 0/O und 1/I, damit man nichts verwechselt
local function newCode()
	local t = {}
	for i = 1, 5 do
		local k = math.random(1, #LETTERS)
		t[i] = LETTERS:sub(k, k)
	end
	return table.concat(t)
end

-- Ist dieser Server selbst ein privater Raum?
function Rooms.isRoom()
	return game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
end

-- Raum-Code aus den Teleport-Daten eines beitretenden Spielers
function Rooms.codeFromJoin(player)
	local ok, data = pcall(function() return player:GetJoinData() end)
	if ok and type(data) == "table" and type(data.TeleportData) == "table" then
		return data.TeleportData.room
	end
	return nil
end

local function teleport(player, access, code)
	local opts = Instance.new("TeleportOptions")
	opts.ReservedServerAccessCode = access
	opts:SetTeleportData({ room = code })
	local ok, err = pcall(function() TeleportService:TeleportAsync(game.PlaceId, { player }, opts) end)
	return ok, err
end

-- gibt (true, code) oder (false, Fehlertext) zurück
function Rooms.create(player)
	if not map then return false, "Räume sind gerade nicht verfügbar" end
	local okR, access = pcall(function() return TeleportService:ReserveServer(game.PlaceId) end)
	if not okR or not access then return false, "In Roblox Studio gehen Räume nicht. Teste sie im veröffentlichten Spiel." end
	local code
	for _ = 1, 5 do
		code = newCode()
		local okG, existing = pcall(function() return map:GetAsync(code) end)
		if okG and existing == nil then break end
	end
	local okS = pcall(function() map:SetAsync(code, access, 3 * 3600) end)
	if not okS then return false, "Raum konnte nicht gespeichert werden" end
	local okT = teleport(player, access, code)
	if not okT then return false, "Teleport fehlgeschlagen, bitte nochmal versuchen" end
	return true, code
end

function Rooms.join(player, code)
	if type(code) ~= "string" then return false, "Ungültiger Code" end
	code = code:upper():gsub("[^A-Z0-9]", "")
	if #code ~= 5 then return false, "Der Code hat 5 Zeichen" end
	if not map then return false, "Räume sind gerade nicht verfügbar" end
	local okG, access = pcall(function() return map:GetAsync(code) end)
	if not okG then return false, "Räume sind gerade nicht verfügbar" end
	if not access then return false, "Diesen Raum gibt es nicht (mehr)" end
	local okT = teleport(player, access, code)
	if not okT then return false, "Teleport fehlgeschlagen, bitte nochmal versuchen" end
	return true, code
end

return Rooms
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">PigmentKriegClient</string><ProtectedString name="Source"><![CDATA[-- Pigment Krieg: Client. Kamera, Steuerung, Animation aller Einheiten, Effekte.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local PK = ReplicatedStorage:WaitForChild("PK")
local Config = require(PK:WaitForChild("Config"))
local Pose = require(PK:WaitForChild("Pose"))
local Lang = require(PK:WaitForChild("Lang"))
local T = Lang.t
local Render = require(script:WaitForChild("Render"))
local UI = require(script:WaitForChild("UI"))
local remotes = PK:WaitForChild("Remotes")
local FxEvent = remotes:WaitForChild("Fx")
local Action = remotes:WaitForChild("Action")
local State = PK:WaitForChild("State")
local UnitsFolder = State:WaitForChild("Units")

local K = Config.K
local WORLD = Config.WORLD_W * K
local clamp, lerp, easeIn = Pose.clamp, Pose.lerp, Pose.easeIn

UI.init({ Render = Render, Action = Action, State = State })

------------------------------------------------------------------ Töne
local SOUNDS = {
	swing = "rbxasset://sounds/swordslash.wav",
	lunge = "rbxasset://sounds/swordlunge.wav",
	spawn = "rbxasset://sounds/unsheath.wav",
	hit = "rbxasset://sounds/collide.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	boom = "rbxasset://sounds/Rocket shot.wav",
}
local lastSound = {}
local function sound(name, vol, pitch, minGap)
	local t = os.clock()
	if lastSound[name] and t - lastSound[name] < (minGap or 0.05) then return end
	lastSound[name] = t
	local s = Instance.new("Sound")
	s.SoundId = SOUNDS[name]
	s.Volume = vol or 0.5
	s.PlaybackSpeed = (pitch or 1) * (0.92 + math.random() * 0.16)
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 3)
end

------------------------------------------------------------------ Einheiten
local units = {}
local time = 0

local function mySide() return player:GetAttribute("Side") or 0 end

local function addUnit(cfg)
	local id = tonumber(cfg.Name)
	if not id or units[id] then return end
	local info = {
		type = cfg:GetAttribute("Type"), side = cfg:GetAttribute("Side"), tier = cfg:GetAttribute("Tier") or 1,
		helmet = cfg:GetAttribute("Helmet") or "none", scale = cfg:GetAttribute("Scale") or 1,
		skin = cfg:GetAttribute("Skin"),
	}
	if not info.type or not info.side then return end
	local st = Render.buildStick(info)
	local u = {
		id = id, cfg = cfg, st = st, type = info.type, side = info.side, scale = info.scale,
		x = cfg:GetAttribute("X") or 0, z = cfg:GetAttribute("Z") or 17, dir = cfg:GetAttribute("Dir") or 1,
		speed = cfg:GetAttribute("Speed") or 60, phase = math.random() * 6.28, seed = math.random() * 100,
		born = time, hurt = 0, blockT = 0, flash = 0, healT = 0, cheer = 0, combo = 0, attacking = false, atkT = 0,
		boss = cfg:GetAttribute("Boss") == true,
	}
	units[id] = u
	if cfg:GetAttribute("Hero") then
		u.hero = true
		u.mine = cfg:GetAttribute("Owner") == player.UserId
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(160, 30)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.6 * u.scale, 0)
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Adornee = st.head
		local tl = Instance.new("TextLabel")
		tl.BackgroundTransparency = 1
		tl.Size = UDim2.fromScale(1, 1)
		tl.Font = Enum.Font.FredokaOne
		tl.TextScaled = true
		tl.Text = u.mine and ("★ " .. (cfg:GetAttribute("Name") or "")) or (cfg:GetAttribute("Name") or "")
		tl.TextColor3 = u.mine and Color3.fromRGB(255, 214, 61) or (u.side == 1 and Color3.fromRGB(40, 40, 46) or Color3.new(1, 1, 1))
		tl.TextStrokeTransparency = 0.2
		tl.TextStrokeColor3 = u.side == 1 and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
		tl.Parent = bb
		bb.Parent = st.model
		local orb = Render.newPart(st.model, u.side == 1 and Color3.new(1, 1, 1) or Color3.fromRGB(20, 20, 24), Enum.PartType.Ball, Enum.Material.Neon, Vector3.new(1.3, 1.3, 1.3))
		orb.CastShadow = false
		orb.Transparency = 1
		local l = Instance.new("PointLight"); l.Range = 10; l.Brightness = 2; l.Color = Color3.fromRGB(255, 220, 120); l.Enabled = false; l.Parent = orb
		u.orb = orb
		table.insert(st.all, orb)
	end
	Render.splat(u.x, u.z, 14 * u.scale, u.side)
	Render.emit("ink" .. u.side, Render.W(u.x, -2, u.z), 10, 0)
	if u.side == mySide() then sound("spawn", 0.35, 1.2, 0.08) end
end

local function removeUnit(id)
	local u = units[id]
	if not u then return end
	u.st.model:Destroy()
	units[id] = nil
end

UnitsFolder.ChildAdded:Connect(addUnit)
for _, c in ipairs(UnitsFolder:GetChildren()) do addUnit(c) end
UnitsFolder.ChildRemoved:Connect(function(cfg)
	local id = tonumber(cfg.Name)
	local u = id and units[id]
	if u and not u.dead then removeUnit(id) end
end)

local function currentJoints(u)
	local p = Pose.compute(u, time)
	local J = Pose.solve(p, u.scale, u.dir)
	for k, v in pairs(J) do
		if type(v) == "table" then J[k] = { v[1] + u.x, v[2] } end
	end
	return J, p
end

------------------------------------------------------------------ Kamera
local cam = workspace.CurrentCamera
local camX = 30
local autoT = 0
local shake = 0
local FOV, DIST = 45, 46
local keys = {}
local function halfWidth()
	local vp = cam.ViewportSize
	return math.tan(math.rad(FOV / 2)) * DIST * (vp.X / math.max(vp.Y, 1))
end
local function clampCam()
	local hw = halfWidth()
	if hw * 2 > WORLD + 12 then camX = WORLD / 2 else camX = clamp(camX, hw - 6, WORLD - hw + 6) end
end

local function myHero()
	for _, u in pairs(units) do
		if u.mine and not u.dead then return u end
	end
	return nil
end

local function updateCamera(dt)
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = FOV
	local side = mySide()
	local phase = State:GetAttribute("Phase")
	local mh = myHero()
	if not mh then
		if keys.left then camX = camX - 60 * dt; autoT = 3 end
		if keys.right then camX = camX + 60 * dt; autoT = 3 end
	end
	autoT = autoT - dt
	if autoT <= 0 then
		local target
		if phase == "end" then
			local w = State:GetAttribute("Winner") or 0
			if w ~= 0 then target = (w == 1 and Config.WORLD_W - 130 or 130) * K end
		elseif mh then
			target = mh.x * K + mh.dir * halfWidth() * 0.15
		elseif side ~= 0 then
			local dir = Config.SIDES[side].dir
			local front = nil
			for _, u in pairs(units) do
				if not u.dead and u.side == side then
					if not front or u.x * dir > front * dir then front = u.x end
				end
			end
			front = front or (side == 1 and 130 or Config.WORLD_W - 130)
			for _, u in pairs(units) do
				if not u.dead and u.side ~= side and (u.x - front) * dir < 300 and (u.x - front) * dir > 0 then
					front = u.x
				end
			end
			target = front * K + dir * halfWidth() * 0.15
		else
			local sum, n = 0, 0
			for _, u in pairs(units) do if not u.dead then sum = sum + u.x; n = n + 1 end end
			target = n > 0 and (sum / n) * K or WORLD / 2
		end
		if target then camX = lerp(camX, target, 1 - 0.3 ^ dt) end
	end
	clampCam()
	shake = shake * (0.002 ^ dt)
	local sx = (math.random() - 0.5) * shake
	local sy = (math.random() - 0.5) * shake * 0.6
	local eye = Vector3.new(camX + sx, 8.5 + sy, DIST)
	cam.CFrame = CFrame.lookAt(eye, Vector3.new(camX + sx * 0.5, 5.5, 0))
end

------------------------------------------------------------------ Steuerung
local targeting = false
local aimPart = Render.newPart(Render.root, Color3.fromRGB(255, 80, 50), Enum.PartType.Cylinder, Enum.Material.Neon, Vector3.new(0.1, 28, 28))
aimPart.Transparency = 1
aimPart.CastShadow = false

local function cancelAim()
	targeting = false
	UI.targeting = false
	aimPart.Transparency = 1
end
local function screenToWorldX(pos)
	local ray = cam:ScreenPointToRay(pos.X, pos.Y)
	if math.abs(ray.Direction.Z) < 1e-4 then return nil end
	local t = -ray.Origin.Z / ray.Direction.Z
	local hit = ray.Origin + ray.Direction * t
	return hit.X / K
end
local function setAim(pos)
	local x = screenToWorldX(pos)
	if not x then return end
	aimPart.CFrame = CFrame.new(x * K, 0.12, 0) * CFrame.Angles(0, 0, math.pi / 2)
	aimPart.Transparency = 0.55
end

local function canAct() return mySide() ~= 0 and State:GetAttribute("Phase") == "battle" end

UI.onSpawn = function(t)
	if not canAct() then return end
	local def = Config.UNITS[t]
	local gold = State:GetAttribute("Gold" .. mySide()) or 0
	if gold < def.cost then UI.toast(T("Zu wenig Gold für %s", T(def.name)), 1.2); return end
	Action:FireServer("spawn", t)
end
UI.onAbility = function(k)
	if not canAct() then return end
	local cd = State:GetAttribute("Ab" .. mySide() .. "_" .. k) or 0
	if cd > 0 then UI.toast(T("%s lädt noch %d s", T(Config.ABILITIES[k].name), math.ceil(cd)), 1.2); return end
	if k == "meteor" then
		if targeting then cancelAim(); return end
		targeting = true
		UI.targeting = true
		local vp = cam.ViewportSize
		setAim(Vector2.new(vp.X * 0.65, vp.Y * 0.6))
		return
	end
	Action:FireServer("ability", k)
end
UI.onCmd = function(c) Action:FireServer("cmd", c) end
UI.onCancelAim = cancelAim

local drag = nil
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		drag = { start = input.Position, cam = camX, moved = 0, input = input }
		if targeting then setAim(input.Position) end
	elseif t == Enum.UserInputType.Keyboard then
		local kc = input.KeyCode
		local nums = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven }
		for i, n in ipairs(nums) do if kc == n then UI.onSpawn(Config.UNIT_ORDER[i]) end end
		if kc == Enum.KeyCode.R then
			UI.onAbility("meteor")
			if targeting then
				local inset = game:GetService("GuiService"):GetGuiInset()
				setAim(UserInputService:GetMouseLocation() - Vector2.new(0, inset.Y))
			end
		elseif kc == Enum.KeyCode.F then UI.onAbility("rage")
		elseif kc == Enum.KeyCode.H then UI.onAbility("heal")
		elseif kc == Enum.KeyCode.Q then UI.onCmd("defend")
		elseif kc == Enum.KeyCode.E then UI.onCmd("attack")
		elseif kc == Enum.KeyCode.A or kc == Enum.KeyCode.Left then keys.left = true
		elseif kc == Enum.KeyCode.D or kc == Enum.KeyCode.Right then keys.right = true
		elseif kc == Enum.KeyCode.Space then keys.atk = true
		elseif kc == Enum.KeyCode.Escape then cancelAim()
		elseif kc == Enum.KeyCode.M then UI.menuForced = not UI.menuForced end
	end
end)
UserInputService.InputChanged:Connect(function(input, gpe)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseWheel and not gpe then
		camX = camX - input.Position.Z * 5
		autoT = 3
		return
	end
	if t == Enum.UserInputType.MouseMovement and targeting and not drag then setAim(input.Position) end
	if drag and (t == Enum.UserInputType.MouseMovement or (t == Enum.UserInputType.Touch and input == drag.input)) then
		local dx = input.Position.X - drag.start.X
		drag.moved = math.max(drag.moved, math.abs(dx))
		if targeting and drag.moved < 12 then setAim(input.Position); return end
		local studsPerPixel = halfWidth() * 2 / math.max(cam.ViewportSize.X, 1)
		camX = drag.cam - dx * studsPerPixel
		autoT = 3.5
	end
end)
UserInputService.InputEnded:Connect(function(input)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then
		local kc = input.KeyCode
		if kc == Enum.KeyCode.A or kc == Enum.KeyCode.Left then keys.left = false end
		if kc == Enum.KeyCode.D or kc == Enum.KeyCode.Right then keys.right = false end
		if kc == Enum.KeyCode.Space then keys.atk = false end
	end
	if drag and (t == Enum.UserInputType.MouseButton1 or (t == Enum.UserInputType.Touch and input == drag.input)) then
		if targeting and drag.moved < 12 then
			local x = screenToWorldX(input.Position)
			if x then Action:FireServer("ability", "meteor", x) end
			cancelAim()
		end
		drag = nil
	end
end)

------------------------------------------------------------------ Effekte vom Server
local streak, streakT = 0, 0
local baseWarnT = 0

local handlers = {}
handlers.attack = function(e)
	local u = units[e[2]]
	if not u or u.dead then return end
	local rm = (State:GetAttribute("Rage" .. u.side) or 0) > 0 and 1.45 or 1
	u.attacking = true
	u.atkStart = time
	u.atkDur = (e[4] or 0.6) / rm
	u.atkT = 0
	u.combo = e[5] or 0
	if u.type == "sword" or u.type == "giant" or u.type == "shield" or u.type == "ninja" then
		task.delay(u.atkDur * 0.35, function() sound("swing", 0.25, u.type == "giant" and 0.7 or 1.1, 0.06) end)
	elseif u.type == "spear" then
		task.delay(u.atkDur * 0.45, function() sound("lunge", 0.25, 1, 0.06) end)
	end
end
handlers.death = function(e)
	local id, dir, power, cut, owner = e[2], e[3], e[4], e[5], e[6]
	local u = units[id]
	if not u or u.dead then return end
	if u.mine then UI.toast(T("Dein Held ist gefallen – zurück in 6 s"), 3) end
	local J = currentJoints(u)
	local rd = Render.makeRagdoll(J, dir * 380 * power, -480 * power, u.scale)
	if cut then rd.cut = true; rd.bleed = 0.7; rd.P[1].px = rd.P[1].px - dir * 5; rd.P[1].py = rd.P[1].py + 7 end
	u.dead = { t = 0, rd = rd, splat = false }
	if u.st.trail then u.st.trail.Enabled = false; u.st.trail = nil end
	Render.setColorMode(u.st, "normal")
	Render.emit("ink" .. u.side, Render.W(u.x, -40 * u.scale, u.z), 26, dir)
	if owner == player.UserId then
		streak = streak + 1
		streakT = 1.6
		if streak == 2 then UI.say("DOPPEL-KILL", "kill")
		elseif streak == 3 then UI.say("TRIPPEL-KILL", "kill")
		elseif streak == 5 then UI.say("MASSAKER!", "kill")
		elseif streak == 8 then UI.say("UNAUFHALTBAR!", "kill") end
	end
end
handlers.proj = function(e)
	Render.addProj(e)
	local kind = e[3]
	if kind == "arrow" or kind == "bolt" then sound("swing", 0.12, 1.8, 0.05)
	elseif kind == "orb" then sound("ping", 0.2, 0.6, 0.08)
	elseif kind == "meteor" then sound("boom", 0.4, 0.5, 0.2) end
end
handlers.projEnd = function(e) Render.endProj(e[2].id) end
handlers.hit = function(e)
	local d = e[2]
	local u = units[d.id]
	local pos = Render.W(d.x, d.y, d.z)
	if u and not u.dead then
		u.hurt = 0.22
		u.flash = 0.1
		if d.blocked then u.blockT = 0.3 end
	end
	if d.blocked then
		Render.emit("spark", pos + Vector3.new(d.dir * -1, 0, 0), 10, 0)
		sound("hit", 0.3, 1.6, 0.04)
		if math.random() < 0.35 then Render.number(d.x, d.y - 50, d.z, "BLOCK", Color3.fromRGB(159, 215, 255), false) end
		return
	end
	Render.emit("ink" .. d.side, pos, d.heavy and 22 or 12, d.dir)
	if d.crit or (d.tier and d.tier >= 3) then Render.emit("spark", pos, 6, 0) end
	local mine = d.src == mySide()
	local col = d.crit and Color3.fromRGB(255, 210, 61) or (mine and Color3.new(1, 1, 1) or Color3.fromRGB(255, 107, 107))
	Render.number(d.x, d.y - 30, d.z, (d.crit and "!" or "") .. math.floor(d.amount + 0.5), col, d.crit)
	sound("hit", d.heavy and 0.45 or 0.3, d.heavy and 0.8 or 1.1, 0.03)
	if d.crit then shake = shake + 0.25 end
end
handlers.clash = function(e)
	local d = e[2]
	Render.emit("spark", Render.W(d.x, d.y, d.z), 16, 0)
	sound("hit", 0.35, 1.9, 0.05)
end
handlers.slam = function(e)
	local d = e[2]
	Render.ring(d.x, d.z, d.r * 1.3, Color3.new(1, 1, 1), 0.45)
	Render.emit("dust", Render.W(d.x, 0, d.z), 18, 0)
	shake = shake + (d.boss and 1.2 or 0.7)
	sound("boom", 0.3, 0.8, 0.1)
end
handlers.explode = function(e)
	local d = e[2]
	Render.blast(d.x, -10, d.z, d.r, d.big, d.side)
	if d.big then shake = shake + 2.2; sound("boom", 0.7, 0.6, 0.1) else shake = shake + 0.3; sound("boom", 0.25, 1.4, 0.06) end
end
handlers.base = function(e)
	local d = e[2]
	Render.emit("ink" .. d.side, Render.W(d.x, -(80 + math.random() * 100), 10), 6, 0)
	if d.side == mySide() and baseWarnT <= 0 then
		baseWarnT = 18
		UI.say("BURG WIRD ANGEGRIFFEN!", "warn")
	end
end
handlers.ability = function(e)
	local d = e[2]
	local bx = d.side == 1 and 130 or Config.WORLD_W - 130
	if d.k == "rage" then
		Render.ring(bx, 17, 500, Color3.fromRGB(255, 70, 40), 0.8)
		for _, u in pairs(units) do if u.side == d.side and not u.dead then u.cheer = 0.8 end end
		sound("boom", 0.3, 1.6, 0.2)
		if d.side == mySide() then UI.say("KRIEGSSCHREI!", "rage") end
	elseif d.k == "heal" then
		Render.ring(bx, 17, 1400, Color3.fromRGB(110, 255, 150), 1.1)
		for _, id in ipairs(d.ids or {}) do
			local u = units[id]
			if u and not u.dead then
				u.healT = 1.2
				Render.emit("heal", Render.W(u.x, -40 * u.scale, u.z), 8, 0)
			end
		end
		sound("ping", 0.4, 1.3, 0.2)
	end
end
handlers.announce = function(e)
	if mySide() ~= 0 then UI.say(e[2].text, e[2].cls) end
	if e[2].cls == "boss" then sound("boom", 0.6, 0.5, 0.3) end
end
handlers.shake = function(e) shake = shake + (e[2].amount or 0.5) end
handlers.over = function(e)
	local w = e[2]
	local s = mySide()
	shake = shake + 2.5
	sound("boom", 0.8, 0.5, 0.2)
	if s ~= 0 then UI.say(w == s and "BURG ZERSTÖRT!" or "BURG GEFALLEN!", w == s and "ok" or "warn") end
	Render.emit("ink" .. (3 - w), Render.W((w == 1 and Config.WORLD_W - 130 or 130), -120, 10), 120, 0)
end
handlers.round = function(e)
	Render.clearDecals()
	Render.clearProjs()
	cancelAim()
	autoT = 0
	local s = mySide()
	camX = (s == 2 and Config.WORLD_W - 300 or 300) * K
	UI.reward = nil
end
handlers.bought = function(e)
	UI.toast(T("Gekauft: %s  Danke!", T(tostring(e[2].name))), 3)
	sound("ping", 0.6, 1.2, 0.1)
end
handlers.room = function(e)
	local d = e[2]
	if not d.ok then UI.toast(T(d.msg), 3.5) end
end
handlers.daily = function(e)
	UI.showDaily(e[2])
	sound("ping", 0.6, 1.5, 0.1)
end
handlers.reward = function(e)
	UI.showReward(e[2])
	sound("ping", 0.5, 1, 0.1)
end

FxEvent.OnClientEvent:Connect(function(batch)
	for _, e in ipairs(batch) do
		local h = handlers[e[1]]
		if h then
			local ok, err = pcall(h, e)
			if not ok then warn("[PigmentKrieg] Effekt-Fehler", e[1], err) end
		end
	end
end)

------------------------------------------------------------------ Held steuern
local lastMove, lastAtk, sendT = 0, false, 0
local function sendHeroInput(dt)
	local h = myHero()
	UI.heroAlive = h ~= nil
	if not h then lastMove, lastAtk = 0, false; return end
	local mv = (keys.right and 1 or 0) - (keys.left and 1 or 0) + (UI.heroMove or 0)
	mv = math.clamp(mv, -1, 1)
	local atk = keys.atk == true or UI.heroAtk == true
	sendT = sendT - dt
	if mv ~= lastMove or atk ~= lastAtk or ((mv ~= 0 or atk) and sendT <= 0) then
		Action:FireServer("hero", mv, atk)
		lastMove, lastAtk = mv, atk
		sendT = 0.2
		autoT = 0
	end
end

------------------------------------------------------------------ Pigment-Raub: Farbe an den Burgen
local pigBoards = {}
for s2 = 1, 2 do
	local a = Instance.new("Attachment")
	a.WorldPosition = Vector3.new((s2 == 1 and 130 or Config.WORLD_W - 130) * K, 34, -1)
	a.Parent = workspace.Terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(150, 50)
	bb.AlwaysOnTop = true
	bb.Enabled = false
	bb.Parent = a
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.TextColor3 = Color3.fromRGB(255, 214, 61)
	tl.TextStrokeTransparency = 0
	tl.Parent = bb
	pigBoards[s2] = { bb = bb, tl = tl }
end
local function updatePigBoards()
	local on = State:GetAttribute("Mode") == "steal" and State:GetAttribute("Phase") ~= "lobby"
	for s2 = 1, 2 do
		pigBoards[s2].bb.Enabled = on
		if on then pigBoards[s2].tl.Text = "🎨 x" .. tostring(State:GetAttribute("Pig" .. s2) or 0) end
	end
end

------------------------------------------------------------------ Hügel-Zone
local hillPart = Render.newPart(Render.root, Color3.fromRGB(255, 204, 61), Enum.PartType.Cylinder, Enum.Material.Neon, Vector3.new(0.12, 34, 34))
hillPart.CastShadow = false
hillPart.Transparency = 1
hillPart.CFrame = CFrame.new(Config.WORLD_W / 2 * K, 0.08, 0) * CFrame.Angles(0, 0, math.pi / 2)
local lastHill = { 0, 0 }
local function updateHill(dt)
	local on = State:GetAttribute("Mode") == "hill" and (State:GetAttribute("Phase") == "battle" or State:GetAttribute("Phase") == "countdown")
	if not on then hillPart.Transparency = 1; return end
	local h1, h2 = State:GetAttribute("Hill1") or 0, State:GetAttribute("Hill2") or 0
	local col = Color3.fromRGB(255, 204, 61)
	if h1 > lastHill[1] then col = Color3.fromRGB(40, 40, 48) elseif h2 > lastHill[2] then col = Color3.fromRGB(250, 250, 250) end
	lastHill[1], lastHill[2] = h1, h2
	hillPart.Color = hillPart.Color:Lerp(col, math.min(1, dt * 3))
	hillPart.Transparency = 0.55 + math.sin(time * 3) * 0.1
end

------------------------------------------------------------------ Bild-Schleife
local TRAIL_WIN = { sword = { 0.36, 0.62 }, spear = { 0.47, 0.62 }, ninja = { 0.35, 0.66 }, giant = { 0.46, 0.62 }, shield = { 0.38, 0.58 } }

RunService:BindToRenderStep("PigmentKrieg", Enum.RenderPriority.Camera.Value + 1, function(dt)
	dt = math.min(dt, 0.05)
	time = time + dt
	streakT = streakT - dt
	if streakT <= 0 then streak = 0 end
	baseWarnT = baseWarnT - dt
	local parts, cfs = {}, {}
	for id, u in pairs(units) do
		if u.dead then
			local d = u.dead
			d.t = d.t + dt
			local rd = d.rd
			Render.stepRagdoll(rd, dt)
			if rd.bleed and rd.bleed > 0 then
				rd.bleed = rd.bleed - dt
				if math.random() < 0.5 then Render.emit("ink" .. u.side, Render.W(rd.P[2].x, rd.P[2].y, u.z), 2, 0) end
			end
			if not d.splat and rd.P[3].y >= -2 * u.scale then
				d.splat = true
				Render.splat(rd.P[3].x, u.z, 20 * u.scale, u.side)
				Render.emit("dust", Render.W(rd.P[3].x, 0, u.z), 3, 0)
			end
			local J, p = Render.ragdollJoints(rd, u.dir)
			Render.place(u.st, J, u.z, u.dir, p, time, parts, cfs)
			if d.t > 4 then Render.setTransparency(u.st, clamp((d.t - 4) / 1.2, 0, 1)) end
			if d.t > 5.3 then removeUnit(id) end
		else
			local cfg = u.cfg
			local tx = cfg:GetAttribute("X") or u.x
			u.moving = cfg:GetAttribute("Moving") == true
			u.dir = cfg:GetAttribute("Dir") or u.dir
			u.victory = cfg:GetAttribute("Victory") == true
			if cfg:GetAttribute("Cheer") and not u.cheerSeen then u.cheer = 0.8; u.cheerSeen = true end
			if not cfg:GetAttribute("Cheer") then u.cheerSeen = false end
			local rage = (State:GetAttribute("Rage" .. u.side) or 0) > 0
			local rm = rage and 1.45 or 1
			if u.moving then
				u.x = u.x + u.dir * u.speed * rm * dt
				u.phase = u.phase + dt * u.speed * rm * 0.11 / u.scale
			end
			u.x = u.x + (tx - u.x) * math.min(1, dt * 6)
			if u.attacking then
				u.atkT = (time - u.atkStart) / u.atkDur
				if u.atkT >= 1 then u.attacking = false; u.atkT = 0 end
			end
			u.hurt = math.max(0, u.hurt - dt)
			u.blockT = math.max(0, u.blockT - dt)
			u.flash = u.flash - dt
			u.healT = u.healT - dt
			u.cheer = math.max(0, u.cheer - dt)
			local p = Pose.compute(u, time)
			local J = Pose.solve(p, u.scale, u.dir)
			local rise = clamp(1 - (time - u.born) / 0.5, 0, 1)
			local yOff = easeIn(rise) * 92 * u.scale
			for k, v in pairs(J) do
				if type(v) == "table" then J[k] = { v[1] + u.x, v[2] + yOff } end
			end
			Render.place(u.st, J, u.z, u.dir, p, time, parts, cfs)
			if u.orb then
				local carry = cfg:GetAttribute("Carry") == true
				u.orb.Transparency = carry and 0.1 or 1
				u.orb.PointLight.Enabled = carry
				if carry then
					table.insert(parts, u.orb)
					table.insert(cfs, CFrame.new(Render.W(J.head[1], J.head[2] - 26 * u.scale - math.sin(time * 5) * 3, u.z)))
				end
			end
			local mode = "normal"
			if u.flash > 0 then mode = "flash" elseif u.healT > 0 then mode = "heal" elseif rage then mode = "rage" end
			Render.setColorMode(u.st, mode)
			Render.updateSkin(u.st, time)
			if u.st.trail then
				local w = TRAIL_WIN[u.type]
				u.st.trail.Enabled = u.attacking and w ~= nil and u.atkT >= w[1] and u.atkT <= w[2]
			end
			if rage and math.random() < dt * 4 then Render.emit("ember", Render.W(u.x, -math.random() * 60 * u.scale, u.z), 1, 0) end
		end
	end
	Render.updateProjs(dt, parts, cfs)
	if #parts > 0 then workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged) end
	Render.updateDecals(dt)
	updateHill(dt)
	sendHeroInput(dt)
	updatePigBoards()
	updateCamera(dt)
	UI.update()
end)

-- Charakter wird nicht gebraucht (Strategie-Ansicht)
player.CharacterAdded:Connect(function(c) task.defer(function() c:Destroy() end) end)
print("[PigmentKrieg] Client bereit")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">Render</string><ProtectedString name="Source"><![CDATA[-- Pigment Krieg: zeichnet Stickmen, Waffen, Helme, Ragdolls, Projektile und Effekte (nur auf dem Client).
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PK = ReplicatedStorage:WaitForChild("PK")
local Config = require(PK:WaitForChild("Config"))
local Pose = require(PK:WaitForChild("Pose"))

local Render = {}
local K = Config.K
local PI = math.pi
local V3 = Vector3.new
local CF = CFrame.new
local ZAXIS = V3(0, 0, 1)

local root = Instance.new("Folder")
root.Name = "PKLocal"
root.Parent = workspace
Render.root = root

local function rgb(t) return Color3.fromRGB(t[1], t[2], t[3]) end
local BODY = { rgb(Config.SIDES[1].color), rgb(Config.SIDES[2].color) }
local BODY_BACK = { Color3.fromRGB(34, 34, 40), Color3.fromRGB(214, 214, 206) }
local RAGE = { Color3.fromRGB(110, 12, 8), Color3.fromRGB(255, 176, 160) }
local FLASH = { Color3.fromRGB(150, 20, 20), Color3.fromRGB(255, 120, 120) }

function Render.zOf(z) return (17 - z) * 0.12 end
local zOf = Render.zOf
-- Spielkoordinaten (y nach unten) -> Welt
local function W(x, y, z) return V3(x * K, -y * K, zOf(z)) end
Render.W = W

local function newPart(parent, color, shape, mat, size)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Material = mat or Enum.Material.SmoothPlastic
	p.Color = color
	if size then p.Size = size end
	p.Parent = parent
	return p
end
Render.newPart = newPart

local function boneCF(a, b)
	local mid = (a + b) * 0.5
	if (b - a).Magnitude < 1e-4 then return CF(mid) end
	return CFrame.lookAt(mid, b, ZAXIS) * CFrame.Angles(0, PI / 2, 0)
end

-- Rahmen entlang einer Waffe: X = Waffenrichtung, Y = senkrecht, Z = zur Kamera
local function weaponFrame(pos, ang, dir)
	local vx = V3(math.sin(ang) * dir, -math.cos(ang), 0)
	local vy = V3(-vx.Y, vx.X, 0)
	return CFrame.fromMatrix(pos, vx, vy)
end

------------------------------------------------------------------ Bauen
local BONES = {
	{ "hip", "lK", 1 }, { "lK", "lFt", 1 }, { "hip", "rK", 1 }, { "rK", "rFt", 1 },
	{ "hip", "neck", 1.25 }, { "sh", "lE", 0.92 }, { "lE", "lH", 0.92 }, { "sh", "rE", 0.92 }, { "rE", "rH", 0.92 },
}
local BACK = { [1] = true, [2] = true, [6] = true, [7] = true }
local BALLS = { "lK", "rK", "lFt", "rFt", "lE", "rE", "lH", "rH", "hip", "neck" }

local function tierLook(tier)
	local T = Config.TIERS[tier] or Config.TIERS[1]
	local mat = Enum.Material.Metal
	if tier == 1 then mat = Enum.Material.Wood elseif T.neon then mat = Enum.Material.Neon end
	return rgb(T.color), mat
end

local WOOD = Color3.fromRGB(90, 60, 36)

-- Teile einer Waffe: { part, a (entlang), b (quer), extra CFrame }
local function buildWeapon(m, ty, tier, s, side)
	local col, mat = tierLook(tier)
	local list, list2, board = {}, nil, nil
	local function add(L, shape, color, material, size, a, b, extra)
		local p = newPart(m, color, shape, material, size * s)
		p.CastShadow = false
		table.insert(L, { p = p, a = a * s, b = (b or 0) * s, x = extra })
		return p
	end
	local trailParts = nil
	if ty == "sword" then
		add(list, nil, WOOD, Enum.Material.Wood, V3(0.6, 0.2, 0.2), -0.25)
		add(list, nil, Color3.fromRGB(70, 60, 50), Enum.Material.Metal, V3(0.16, 1.0, 0.24), 0.05)
		local blade = add(list, nil, col, mat, V3(2.8, 0.34, 0.08), 1.55)
		trailParts = { blade, 1.3 * s, -1.25 * s }
	elseif ty == "spear" then
		add(list, Enum.PartType.Cylinder, WOOD, Enum.Material.Wood, V3(6.6, 0.22, 0.22), 0.7)
		local tip = add(list, nil, col, mat, V3(0.7, 0.7, 0.08), 4.3, 0, CFrame.Angles(0, 0, PI / 4))
		trailParts = { tip, 0.3 * s, -0.3 * s }
	elseif ty == "archer" then
		local bc = tier == 1 and Color3.fromRGB(122, 79, 38) or col
		add(list, nil, bc, tier == 1 and Enum.Material.Wood or mat, V3(0.22, 1.5, 0.16), -0.45)
		add(list, nil, bc, tier == 1 and Enum.Material.Wood or mat, V3(0.22, 1.3, 0.16), -0.8, 1.2, CFrame.Angles(0, 0, math.rad(28)))
		add(list, nil, bc, tier == 1 and Enum.Material.Wood or mat, V3(0.22, 1.3, 0.16), -0.8, -1.2, CFrame.Angles(0, 0, math.rad(-28)))
		add(list, nil, Color3.fromRGB(230, 230, 230), Enum.Material.SmoothPlastic, V3(0.04, 3.4, 0.04), -1.15)
		local arrow = add(list, nil, Color3.fromRGB(216, 201, 168), Enum.Material.Wood, V3(3.0, 0.1, 0.1), 0.2)
		arrow.Transparency = 1
		list[#list].skip = true
	elseif ty == "ninja" then
		add(list, nil, Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic, V3(0.35, 0.16, 0.16), -0.1)
		local b1 = add(list, nil, col, mat, V3(1.3, 0.22, 0.06), 0.7)
		list2 = {}
		add(list2, nil, Color3.fromRGB(30, 30, 30), Enum.Material.SmoothPlastic, V3(0.35, 0.16, 0.16), -0.1)
		add(list2, nil, col, mat, V3(1.3, 0.22, 0.06), 0.7)
		trailParts = { b1, 0.6 * s, -0.6 * s }
	elseif ty == "shield" then
		add(list, Enum.PartType.Cylinder, WOOD, Enum.Material.Wood, V3(2.0, 0.22, 0.22), 0.9)
		local head = add(list, Enum.PartType.Ball, tier == 1 and Color3.fromRGB(125, 125, 125) or col, tier == 1 and Enum.Material.Metal or mat, V3(0.9, 0.9, 0.9), 2.0)
		trailParts = { head, 0.4 * s, -0.4 * s }
		board = newPart(m, tier == 1 and Color3.fromRGB(138, 90, 46) or col, nil, tier == 1 and Enum.Material.WoodPlanks or mat, V3(0.45, 3.9, 2.4) * s)
		local boss = newPart(m, BODY[side], Enum.PartType.Ball, Enum.Material.SmoothPlastic, V3(0.8, 0.8, 0.8) * s)
		board = { board, boss }
	elseif ty == "mage" then
		add(list, Enum.PartType.Cylinder, Color3.fromRGB(74, 50, 32), Enum.Material.Wood, V3(4.4, 0.22, 0.22), 0.8)
		local crystalCol = tier == 1 and (side == 1 and Color3.fromRGB(155, 107, 255) or Color3.fromRGB(107, 208, 255)) or col
		add(list, Enum.PartType.Ball, crystalCol, Enum.Material.Neon, V3(0.6, 0.6, 0.6), 3.3)
		local orb = add(list, Enum.PartType.Ball, crystalCol, Enum.Material.Neon, V3(1, 1, 1), 3.4)
		orb.Transparency = 1
		local light = Instance.new("PointLight"); light.Color = crystalCol; light.Range = 0; light.Brightness = 3; light.Parent = orb
	elseif ty == "giant" then
		add(list, Enum.PartType.Cylinder, Color3.fromRGB(78, 52, 32), Enum.Material.Wood, V3(4.2, 0.3, 0.3), 1.5)
		local head = add(list, nil, tier == 1 and Color3.fromRGB(109, 109, 109) or col, tier == 1 and Enum.Material.Metal or mat, V3(1.2, 2.2, 1.3), 3.6)
		trailParts = { head, 0, -1.0 * s }
	end
	local trail = nil
	if trailParts then
		local a0 = Instance.new("Attachment"); a0.Position = V3(trailParts[2], 0, 0); a0.Parent = trailParts[1]
		local a1 = Instance.new("Attachment"); a1.Position = V3(trailParts[3], 0, 0); a1.Parent = trailParts[1]
		trail = Instance.new("Trail")
		trail.Attachment0 = a0; trail.Attachment1 = a1
		trail.Lifetime = 0.16
		trail.MinLength = 0
		trail.FaceCamera = true
		trail.LightEmission = (Config.TIERS[tier] and Config.TIERS[tier].neon) and 1 or 0.3
		trail.Color = ColorSequence.new((tier >= 3) and col or (side == 1 and Color3.fromRGB(30, 30, 30) or Color3.new(1, 1, 1)))
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
		trail.WidthScale = NumberSequence.new(1)
		trail.Enabled = false
		trail.Parent = trailParts[1]
	end
	return list, list2, board, trail
end

local SKIN = Color3.fromRGB(255, 214, 170)

local function buildHelmet(m, id, s, side)
	local r = 7.6 * s * K
	local list = {}
	local function add(shape, color, mat, size, ox, oy, oz, extra)
		local p = newPart(m, color, shape, mat, size)
		table.insert(list, { p = p, o = V3(ox, oy, oz), x = extra })
		return p
	end
	if id == "none" then
		add(nil, side == 1 and Color3.new(1, 1, 1) or Color3.new(0, 0, 0), Enum.Material.Neon, V3(r * 0.5, r * 0.2, 0.05), r * 0.42, r * 0.12, r * 0.88)
	elseif id == "knight" then
		add(Enum.PartType.Ball, Color3.fromRGB(165, 175, 186), Enum.Material.Metal, V3(1, 1, 1) * r * 2.36, 0, r * 0.06, 0)
		add(nil, Color3.fromRGB(15, 15, 15), Enum.Material.SmoothPlastic, V3(r * 1.0, r * 0.2, r * 2.2), r * 0.62, r * 0.08, 0)
		add(nil, Color3.fromRGB(192, 57, 43), Enum.Material.Fabric, V3(r * 1.3, r * 0.4, r * 0.32), -r * 0.6, r * 1.2, 0, CFrame.Angles(0, 0, math.rad(-30)))
	elseif id == "viking" then
		add(Enum.PartType.Ball, Color3.fromRGB(143, 154, 165), Enum.Material.Metal, V3(1, 1, 1) * r * 2.26, 0, r * 0.12, 0)
		add(Enum.PartType.Cylinder, Color3.fromRGB(107, 74, 42), Enum.Material.Wood, V3(r * 0.4, r * 2.32, r * 2.32), 0, -r * 0.15, 0, CFrame.Angles(0, 0, PI / 2))
		add(nil, Color3.fromRGB(239, 230, 207), Enum.Material.SmoothPlastic, V3(r * 0.42, r * 1.5, r * 0.42), r * 1.05, r * 1.0, 0, CFrame.Angles(0, 0, math.rad(-35)))
		add(nil, Color3.fromRGB(239, 230, 207), Enum.Material.SmoothPlastic, V3(r * 0.42, r * 1.5, r * 0.42), -r * 1.05, r * 1.0, 0, CFrame.Angles(0, 0, math.rad(35)))
	elseif id == "ninja" then
		add(Enum.PartType.Cylinder, Color3.fromRGB(196, 22, 28), Enum.Material.Fabric, V3(r * 0.45, r * 2.12, r * 2.12), 0, r * 0.35, 0, CFrame.Angles(0, 0, PI / 2))
		add(nil, Color3.fromRGB(196, 22, 28), Enum.Material.Fabric, V3(r * 1.6, r * 0.24, r * 0.08), -r * 1.6, r * 0.4, r * 0.3, "wave")
		add(nil, Color3.fromRGB(196, 22, 28), Enum.Material.Fabric, V3(r * 1.3, r * 0.22, r * 0.08), -r * 1.45, r * 0.05, r * 0.4, "wave2")
	elseif id == "sparta" then
		add(Enum.PartType.Ball, Color3.fromRGB(226, 172, 70), Enum.Material.Metal, V3(1, 1, 1) * r * 2.3, 0, r * 0.06, 0)
		add(nil, Color3.fromRGB(179, 20, 27), Enum.Material.Fabric, V3(r * 2.4, r * 0.75, r * 0.3), -r * 0.15, r * 1.25, 0)
		add(nil, Color3.fromRGB(15, 15, 15), Enum.Material.SmoothPlastic, V3(r * 0.25, r * 1.2, r * 2.35), r * 0.75, -r * 0.2, 0)
	elseif id == "crown" then
		add(Enum.PartType.Cylinder, Color3.fromRGB(240, 180, 30), Enum.Material.Metal, V3(r * 0.6, r * 1.9, r * 1.9), 0, r * 0.95, 0, CFrame.Angles(0, 0, PI / 2))
		for i = -1, 1 do
			add(nil, Color3.fromRGB(255, 215, 70), Enum.Material.Metal, V3(r * 0.32, r * 0.7, r * 0.32), i * r * 0.62, r * 1.5, r * 0.6, CFrame.Angles(0, 0, -i * 0.25))
		end
		add(Enum.PartType.Ball, Color3.fromRGB(224, 32, 74), Enum.Material.Neon, V3(1, 1, 1) * r * 0.38, 0, r * 0.95, r * 0.95)
	elseif id == "halo" then
		local ring = add(Enum.PartType.Cylinder, Color3.fromRGB(255, 230, 120), Enum.Material.Neon, V3(r * 0.12, r * 2.1, r * 2.1), 0, r * 1.75, 0, CFrame.Angles(0.55, 0, PI / 2))
		ring.Transparency = 0.15
		ring.CastShadow = false
		local l = Instance.new("PointLight"); l.Color = ring.Color; l.Range = 8; l.Brightness = 2; l.Parent = ring
		add(Enum.PartType.Ball, Color3.fromRGB(255, 255, 255), Enum.Material.Neon, V3(1, 1, 1) * r * 0.3, r * 0.42, r * 0.1, r * 0.85)
	elseif id == "visor" then
		add(Enum.PartType.Ball, Color3.fromRGB(30, 32, 40), Enum.Material.Metal, V3(1, 1, 1) * r * 2.3, 0, r * 0.08, 0)
		local band = add(nil, Color3.fromRGB(60, 240, 255), Enum.Material.Neon, V3(r * 1.25, r * 0.38, r * 2.4), r * 0.4, r * 0.05, 0)
		local l = Instance.new("PointLight"); l.Color = band.Color; l.Range = 7; l.Brightness = 2; l.Parent = band
		add(nil, Color3.fromRGB(60, 240, 255), Enum.Material.Neon, V3(r * 0.2, r * 1.2, r * 0.2), -r * 0.2, r * 1.4, 0, CFrame.Angles(0, 0, math.rad(-20)))
	elseif id == "flame" then
		add(Enum.PartType.Cylinder, Color3.fromRGB(255, 120, 30), Enum.Material.Neon, V3(r * 0.4, r * 2.15, r * 2.15), 0, r * 0.45, 0, CFrame.Angles(0, 0, PI / 2))
		local top = add(nil, Color3.fromRGB(255, 120, 30), Enum.Material.Neon, V3(r * 0.4, r * 0.4, r * 0.4), 0, r * 0.95, 0)
		top.Transparency = 1
		local f = Instance.new("Fire"); f.Size = math.max(2, r * 4); f.Heat = 9; f.Color = Color3.fromRGB(255, 150, 40); f.SecondaryColor = Color3.fromRGB(255, 40, 10); f.Parent = top
		local l = Instance.new("PointLight"); l.Color = Color3.fromRGB(255, 130, 40); l.Range = 9; l.Brightness = 2.5; l.Parent = top
	elseif id == "dragon" then
		local red = Color3.fromRGB(120, 16, 16)
		add(Enum.PartType.Ball, red, Enum.Material.Slate, V3(1, 1, 1) * r * 2.4, 0, r * 0.1, 0)
		add(nil, Color3.fromRGB(240, 225, 190), Enum.Material.SmoothPlastic, V3(r * 0.45, r * 1.9, r * 0.45), -r * 0.75, r * 1.25, r * 0.55, CFrame.Angles(0, 0, math.rad(40)))
		add(nil, Color3.fromRGB(240, 225, 190), Enum.Material.SmoothPlastic, V3(r * 0.45, r * 1.9, r * 0.45), -r * 0.75, r * 1.25, -r * 0.55, CFrame.Angles(0, 0, math.rad(40)))
		for i = 0, 2 do
			add(nil, Color3.fromRGB(70, 8, 8), Enum.Material.Slate, V3(r * 0.45, r * 0.45, r * 0.2), r * (0.5 - i * 0.6), r * (1.15 - i * 0.12), 0, CFrame.Angles(0, 0, PI / 4))
		end
		local eye = add(nil, Color3.fromRGB(255, 220, 40), Enum.Material.Neon, V3(r * 0.5, r * 0.22, 0.05), r * 0.55, r * 0.1, r * 1.0)
		eye.CastShadow = false
	elseif id == "vipcrown" then
		local gold = Color3.fromRGB(255, 200, 40)
		add(Enum.PartType.Cylinder, gold, Enum.Material.Metal, V3(r * 0.8, r * 2.2, r * 2.2), 0, r * 1.0, 0, CFrame.Angles(0, 0, PI / 2))
		for i = -2, 2 do
			add(nil, gold, Enum.Material.Metal, V3(r * 0.3, r * 0.95, r * 0.3), i * r * 0.45, r * 1.7, r * 0.75, CFrame.Angles(0, 0, -i * 0.15))
		end
		local gem = add(Enum.PartType.Ball, Color3.fromRGB(180, 60, 255), Enum.Material.Neon, V3(1, 1, 1) * r * 0.45, 0, r * 1.0, r * 1.1)
		local sp = Instance.new("Sparkles"); sp.SparkleColor = Color3.fromRGB(255, 220, 120); sp.Parent = gem
	elseif id == "face" then
		-- Bild auf einer unsichtbaren Platte vor dem Kopf; der Kopf dahinter bildet den Helmrand
		local stateF = PK:FindFirstChild("State")
		local faceId = tostring((stateF and stateF:GetAttribute("FaceImage")) or Config.FACE_IMAGE or "")
		if faceId:match("^%d+$") then faceId = "rbxassetid://" .. faceId end
		local custom = faceId ~= ""
		local plate = add(nil, SKIN, Enum.Material.SmoothPlastic, custom and V3(r * 2.3, r * 3.1, 0.04) or V3(r * 1.9, r * 1.9, 0.04), 0, custom and r * 0.25 or 0, r * (custom and 1.3 or 1.15))
		plate.Transparency = 1
		plate.CastShadow = false
		local dec = Instance.new("Decal")
		dec.Face = Enum.NormalId.Back
		dec.Texture = custom and faceId or "rbxasset://textures/face.png"
		dec.Parent = plate
	end
	return list
end

-- erzeugt einen Stickman. info: { type, side, tier, helmet, scale }
function Render.buildStick(info, parent)
	local s = info.scale or 1
	local side = info.side
	local m = Instance.new("Model")
	m.Name = info.type
	m.Parent = parent or root
	local lw = 4.2 * s * K
	local st = { model = m, s = s, side = side, type = info.type, bones = {}, balls = {}, all = {} }
	for i, b in ipairs(BONES) do
		local p = newPart(m, BACK[i] and BODY_BACK[side] or BODY[side], Enum.PartType.Cylinder, nil, V3(1, lw * b[3], lw * b[3]))
		st.bones[i] = p
	end
	for _, name in ipairs(BALLS) do
		local d = (name == "hip" or name == "neck") and lw * 1.15 or lw * 0.98
		st.balls[name] = newPart(m, BODY[side], Enum.PartType.Ball, nil, V3(d, d, d))
	end
	local hr = 7.6 * s * K
	local hd = hr * 2
	local headCol = BODY[side]
	if info.helmet == "face" then
		local stateF = PK:FindFirstChild("State")
		local fimg = tostring((stateF and stateF:GetAttribute("FaceImage")) or Config.FACE_IMAGE or "")
		if fimg ~= "" then hd = hr * 2.6 else hd = hr * 2.4; headCol = SKIN; st.skinHead = true end
	end
	st.head = newPart(m, headCol, Enum.PartType.Ball, nil, V3(hd, hd, hd))
	st.weapon, st.weapon2, st.board, st.trail = buildWeapon(m, info.type, info.tier or 1, s, side)
	st.helmet = buildHelmet(m, info.helmet or "none", s, side)
	if info.skin == "rainbow" then
		st.rainbow = {}
		for _, L in ipairs({ st.weapon or {}, st.weapon2 or {} }) do
			for _, e in ipairs(L) do
				if e.p.Material ~= Enum.Material.Wood and e.p.Transparency < 1 then
					e.p.Material = Enum.Material.Neon
					table.insert(st.rainbow, e.p)
				end
			end
		end
	end
	st.helmetId = info.helmet
	-- Längen der Knochen einmalig (bleiben konstant)
	local lens = { 15, 15, 15, 15, 24, 12, 12, 12, 12 }
	for i, p in ipairs(st.bones) do
		p.Size = V3(lens[i] * s * K + lw * 0.2, p.Size.Y, p.Size.Z)
	end
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(st.all, d) end
	end
	st.colorMode = "normal"
	return st
end

function Render.updateSkin(st, time)
	if not st.rainbow then return end
	for i, p in ipairs(st.rainbow) do
		p.Color = Color3.fromHSV((time * 0.45 + i * 0.12) % 1, 0.85, 1)
	end
	if st.trail then st.trail.Color = ColorSequence.new(Color3.fromHSV((time * 0.45) % 1, 0.85, 1)) end
end

function Render.setColorMode(st, mode)
	if st.colorMode == mode then return end
	st.colorMode = mode
	local side = st.side
	local c, cb = BODY[side], BODY_BACK[side]
	if mode == "flash" then c = FLASH[side]; cb = c
	elseif mode == "rage" then c = RAGE[side]; cb = c
	elseif mode == "heal" then c = Color3.fromRGB(80, 255, 140); cb = c end
	for i, p in ipairs(st.bones) do p.Color = BACK[i] and cb or c end
	for _, p in pairs(st.balls) do p.Color = c end
	if not st.skinHead then st.head.Color = c end
end

function Render.setTransparency(st, t)
	for _, p in ipairs(st.all) do
		if p:GetAttribute("baseT") == nil then p:SetAttribute("baseT", p.Transparency) end
		local b = p:GetAttribute("baseT")
		p.Transparency = b + (1 - b) * t
	end
end

------------------------------------------------------------------ Platzieren
-- J: absolute Spielkoordinaten der Gelenke ({x,y}), z: Tiefe. Fügt Teile/CFrames an die Listen an.
function Render.place(st, J, z, dir, p, time, parts, cfs)
	local Z = zOf(z)
	local function w(v) return V3(v[1] * K, -v[2] * K, Z) end
	local pts = {}
	for k, v in pairs(J) do
		if type(v) == "table" then pts[k] = w(v) end
	end
	for i, b in ipairs(BONES) do
		local a, c = pts[b[1]], pts[b[2]]
		table.insert(parts, st.bones[i]); table.insert(cfs, boneCF(a, c))
	end
	for name, ball in pairs(st.balls) do
		table.insert(parts, ball); table.insert(cfs, CF(pts[name]))
	end
	local hp = pts.head
	table.insert(parts, st.head); table.insert(cfs, CF(hp))
	-- Waffe
	local s = st.s
	local function placeWeapon(list, hand, ang)
		local f = weaponFrame(hand, ang, dir)
		for _, e in ipairs(list) do
			if not e.skip then
				local c = f * CF(e.a, e.b, 0)
				if e.x then c = c * e.x end
				table.insert(parts, e.p); table.insert(cfs, c)
			end
		end
	end
	if st.type == "archer" then
		placeWeapon(st.weapon, pts.lH, p.w)
		local arrow = st.weapon[5]
		if arrow then
			arrow.p.Transparency = (p.draw or 0) > 0.05 and 0 or 1
			local f = weaponFrame(pts.lH, p.w, dir)
			table.insert(parts, arrow.p); table.insert(cfs, f * CF(-1.4 * s * (p.draw or 0) + 0.3 * s, 0, 0))
		end
	else
		placeWeapon(st.weapon, pts.rH, p.w)
	end
	if st.weapon2 then placeWeapon(st.weapon2, pts.lH, p.w2) end
	if st.board then
		local bf = CF(pts.lH + V3(dir * 0.25 * s, 0, 0)) * CFrame.Angles(0, math.rad(50) * dir, -(p.lean or 0) * 0.6 * dir)
		table.insert(parts, st.board[1]); table.insert(cfs, bf)
		table.insert(parts, st.board[2]); table.insert(cfs, bf * CF(0, 0, 0))
	end
	if st.type == "mage" then
		local orb = st.weapon[3]
		local ch = p.charge or 0
		orb.p.Transparency = ch > 0.02 and 0.15 or 1
		local d = (0.4 + ch * 1.6) * s
		if math.abs(orb.p.Size.X - d) > 0.02 then orb.p.Size = V3(d, d, d) end
		local light = orb.p:FindFirstChildOfClass("PointLight")
		if light then light.Range = ch * 14 end
	end
	-- Helm im Kopf-Rahmen
	local hcf = CF(hp) * CFrame.Angles(0, 0, -(J.headA or 0) * dir)
	for _, e in ipairs(st.helmet) do
		local o = e.o
		local c = hcf * CF(o.X * dir, o.Y, o.Z)
		if e.x == "wave" then c = c * CFrame.Angles(0, 0, math.sin(time * 14) * 0.3 * dir)
		elseif e.x == "wave2" then c = c * CFrame.Angles(0, 0, (-0.4 + math.sin(time * 12 + 1) * 0.3) * dir)
		elseif e.x then
			local rx, ry, rz = e.x:ToEulerAnglesXYZ()
			c = c * CFrame.Angles(rx, ry, rz * dir)
		end
		table.insert(parts, e.p); table.insert(cfs, c)
	end
end

------------------------------------------------------------------ Ragdoll (Verlet)
local RD = { { 1, 2 }, { 2, 3 }, { 3, 4 }, { 4, 5 }, { 3, 6 }, { 6, 7 }, { 2, 8 }, { 8, 9 }, { 2, 10 }, { 10, 11 }, { 1, 3 } }
local NAMES = { "head", "neck", "hip", "lK", "lFt", "rK", "rFt", "lE", "lH", "rE", "rH" }

function Render.makeRagdoll(J, vx, vy, scale)
	local P = {}
	local h = 70 * scale
	for i, n in ipairs(NAMES) do
		local v = J[n]
		local up = Pose.clamp(-v[2] / h, 0, 1)
		local k = 0.35 + 0.9 * up
		local dt = 1 / 60
		P[i] = { x = v[1], y = v[2], px = v[1] - (vx * k + (math.random() - 0.5) * 60) * dt, py = v[2] - (vy * (0.5 + 0.6 * up) + (math.random() - 0.5) * 60) * dt }
	end
	local L = {}
	for i, s in ipairs(RD) do
		local a, b = P[s[1]], P[s[2]]
		L[i] = math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2)
	end
	return { P = P, L = L, pdt = 1 / 60, cut = false, headR = J.headR, settled = 0 }
end

function Render.stepRagdoll(r, dt)
	if dt <= 0 then return end
	local ratio = dt / r.pdt
	r.pdt = dt
	local G = 1500 * dt * dt
	for _, p in ipairs(r.P) do
		local vx, vy = (p.x - p.px) * ratio * 0.996, (p.y - p.py) * ratio * 0.996
		p.px, p.py = p.x, p.y
		p.x = p.x + vx
		p.y = p.y + vy + G
		if p.y > 0 then
			p.y = 0
			p.py = vy * 0.28
			p.px = p.x - vx * 0.5
		end
	end
	for _ = 1, 5 do
		for i, s in ipairs(RD) do
			if not (r.cut and (i == 1 or i == 11)) then
				local A, B = r.P[s[1]], r.P[s[2]]
				local dx, dy = B.x - A.x, B.y - A.y
				local d = math.sqrt(dx * dx + dy * dy)
				if d < 1e-4 then d = 1e-4 end
				local diff = (d - r.L[i]) / d * 0.5
				A.x = A.x + dx * diff; A.y = A.y + dy * diff
				B.x = B.x - dx * diff; B.y = B.y - dy * diff
			end
		end
		for _, p in ipairs(r.P) do if p.y > 0 then p.y = 0 end end
	end
end

-- Ragdoll-Punkte in Gelenk-Tabelle umwandeln (für Render.place)
function Render.ragdollJoints(r, dir)
	local J = {}
	for i, n in ipairs(NAMES) do J[n] = { r.P[i].x, r.P[i].y } end
	J.sh = J.neck
	J.headR = r.headR
	local nk, hd = J.neck, J.head
	J.headA = math.atan2((hd[1] - nk[1]) * dir, -(hd[2] - nk[2]))
	local e, h = J.rE, J.rH
	local we = math.atan2((h[1] - e[1]) * dir, (h[2] - e[2])) + 0.3
	local e2, h2 = J.lE, J.lH
	local we2 = math.atan2((h2[1] - e2[1]) * dir, (h2[2] - e2[2])) + 0.3
	return J, { w = we, w2 = we2, lean = 0, draw = 0, charge = 0 }
end

------------------------------------------------------------------ Effekte
local fxPart = newPart(root, Color3.new(), nil, nil, V3(0.1, 0.1, 0.1))
fxPart.Transparency = 1
fxPart.CastShadow = false

local function emitter(name, props)
	local a = Instance.new("Attachment")
	a.Name = name
	a.Parent = fxPart
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	for k, v in pairs(props) do e[k] = v end
	e.Parent = a
	return { a = a, e = e }
end
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local function ns(a, b) return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) }) end
local function nr(a, b) return NumberRange.new(a, b) end

local E = {}
for side = 1, 2 do
	E["ink" .. side] = emitter("ink" .. side, {
		Texture = SMOKE, Color = ColorSequence.new(side == 1 and Color3.fromRGB(5, 5, 5) or Color3.new(1, 1, 1)),
		Size = ns(0.32, 0.06), Transparency = ns(0, 0.2), Lifetime = nr(0.35, 0.8), Speed = nr(10, 32),
		SpreadAngle = Vector2.new(40, 40), Acceleration = V3(0, -70, 0), Drag = 1.5, LightInfluence = 0.6,
		Rotation = nr(0, 360), EmissionDirection = Enum.NormalId.Top,
	})
end
E.spark = emitter("spark", { Texture = SPARK, Color = ColorSequence.new(Color3.fromRGB(255, 224, 138)), Size = ns(0.5, 0), Lifetime = nr(0.15, 0.35),
	Speed = nr(18, 40), SpreadAngle = Vector2.new(180, 180), LightEmission = 1, Acceleration = V3(0, -40, 0) })
E.dust = emitter("dust", { Texture = SMOKE, Color = ColorSequence.new(Color3.fromRGB(185, 171, 148)), Size = ns(1.2, 3.2), Transparency = ns(0.35, 1),
	Lifetime = nr(0.6, 1.2), Speed = nr(6, 22), SpreadAngle = Vector2.new(80, 15), Drag = 3, EmissionDirection = Enum.NormalId.Top })
E.fire = emitter("fire", { Texture = FIRE, Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(255, 60, 20)), Size = ns(3, 0.5), Transparency = ns(0, 1),
	Lifetime = nr(0.4, 0.9), Speed = nr(10, 40), SpreadAngle = Vector2.new(180, 180), LightEmission = 1, Drag = 2 })
E.heal = emitter("heal", { Texture = SPARK, Color = ColorSequence.new(Color3.fromRGB(110, 255, 150)), Size = ns(0.8, 0), Lifetime = nr(0.6, 1.1),
	Speed = nr(3, 8), SpreadAngle = Vector2.new(30, 30), LightEmission = 1, Acceleration = V3(0, 6, 0) })
E.ember = emitter("ember", { Texture = SPARK, Color = ColorSequence.new(Color3.fromRGB(255, 90, 40)), Size = ns(0.35, 0), Lifetime = nr(0.4, 0.8),
	Speed = nr(2, 6), SpreadAngle = Vector2.new(25, 25), LightEmission = 1, Acceleration = V3(0, 8, 0) })

function Render.emit(kind, pos, n, dir)
	local em = E[kind]
	if not em then return end
	em.a.WorldCFrame = CF(pos) * CFrame.Angles(0, 0, -(dir or 0) * 0.8)
	em.e:Emit(n)
end

-- Tintenflecken am Boden
local decals = {}
function Render.splat(x, z, radius, side)
	local d = radius * K * 2
	local p = newPart(root, side == 1 and Color3.fromRGB(8, 8, 8) or Color3.fromRGB(250, 250, 250), Enum.PartType.Cylinder, nil, V3(0.03, d, d * 0.9))
	p.CastShadow = false
	p.CFrame = CF(x * K, 0.03 + #decals * 0.0004, zOf(z)) * CFrame.Angles(0, math.random() * 6, PI / 2)
	table.insert(decals, { p = p, t = 0 })
	if #decals > 90 then
		local old = table.remove(decals, 1)
		old.p:Destroy()
	end
end
function Render.updateDecals(dt)
	for i = #decals, 1, -1 do
		local d = decals[i]
		d.t = d.t + dt
		if d.t > 25 then
			d.p.Transparency = math.min(1, (d.t - 25) / 5)
			if d.t > 30 then d.p:Destroy(); table.remove(decals, i) end
		end
	end
end
function Render.clearDecals()
	for _, d in ipairs(decals) do d.p:Destroy() end
	decals = {}
end

local function tween(obj, t, props, style)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
Render.tween = tween

function Render.ring(x, z, radius, color, t)
	local p = newPart(root, color or Color3.new(1, 1, 1), Enum.PartType.Cylinder, Enum.Material.Neon, V3(0.1, 0.5, 0.5))
	p.CastShadow = false
	p.Transparency = 0.25
	p.CFrame = CF(x * K, 0.15, zOf(z)) * CFrame.Angles(0, 0, PI / 2)
	local d = radius * K * 2
	tween(p, t or 0.45, { Size = V3(0.1, d, d), Transparency = 1 })
	Debris:AddItem(p, (t or 0.45) + 0.1)
end

function Render.blast(x, y, z, radius, big, side)
	local pos = W(x, y, z)
	local col = big and Color3.fromRGB(255, 160, 60) or (side == 1 and Color3.fromRGB(160, 110, 255) or Color3.fromRGB(110, 210, 255))
	local p = newPart(root, col, Enum.PartType.Ball, Enum.Material.Neon, V3(1, 1, 1))
	p.CastShadow = false
	p.CFrame = CF(pos)
	local d = radius * K * (big and 2.2 or 1.6)
	tween(p, big and 0.45 or 0.3, { Size = V3(d, d, d), Transparency = 1 })
	local l = Instance.new("PointLight"); l.Color = col; l.Range = big and 40 or 16; l.Brightness = big and 8 or 4; l.Parent = p
	tween(l, big and 0.6 or 0.35, { Brightness = 0 })
	Debris:AddItem(p, 0.7)
	Render.ring(x, z, radius * 1.4, Color3.new(1, 1, 1), 0.5)
	Render.emit("ink" .. side, pos, big and 70 or 22, 0)
	Render.emit("dust", W(x, 0, z), big and 26 or 8, 0)
	if big then Render.emit("fire", pos, 40, 0) end
	Render.splat(x, z, radius * 0.45, side)
end

-- Schadenszahlen
local numbers = 0
function Render.number(x, y, z, text, color, big)
	if numbers > 40 then return end
	numbers = numbers + 1
	local a = Instance.new("Attachment")
	a.WorldPosition = W(x + (math.random() - 0.5) * 16, y, z)
	a.Parent = workspace.Terrain
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(big and 120 or 80, big and 44 or 30)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = a
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.TextStrokeTransparency = 0.2
	t.Parent = bb
	tween(bb, 0.9, { StudsOffsetWorldSpace = V3(0, 3, 0) })
	tween(t, 0.9, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quint)
	task.delay(0.95, function() a:Destroy(); numbers = numbers - 1 end)
end

------------------------------------------------------------------ Projektile
local projs = {}
function Render.addProj(d)
	local id, kind = d[2], d[3]
	local pr = { id = id, kind = kind, x = d[4], y = d[5], z = d[6], tz = d[7], vx = d[8], vy = d[9], g = d[10], side = d[11], tier = d[12] }
	local col, mat = tierLook(pr.tier or 1)
	if kind == "arrow" or kind == "bolt" then
		local shaft = newPart(root, Color3.fromRGB(216, 201, 168), nil, Enum.Material.Wood, V3(kind == "bolt" and 2.6 or 2.0, 0.12, 0.12))
		local tip = newPart(root, col, nil, mat, V3(0.35, 0.3, 0.3))
		shaft.CastShadow = false; tip.CastShadow = false
		pr.parts = { shaft, tip }
	elseif kind == "orb" then
		local c = pr.tier >= 3 and col or (pr.side == 1 and Color3.fromRGB(160, 110, 255) or Color3.fromRGB(110, 210, 255))
		local ball = newPart(root, c, Enum.PartType.Ball, Enum.Material.Neon, V3(0.9, 0.9, 0.9))
		local core = newPart(root, BODY[pr.side], Enum.PartType.Ball, nil, V3(0.5, 0.5, 0.5))
		ball.Transparency = 0.2; ball.CastShadow = false; core.CastShadow = false
		local l = Instance.new("PointLight"); l.Color = c; l.Range = 10; l.Brightness = 3; l.Parent = ball
		local a0 = Instance.new("Attachment"); a0.Position = V3(0, 0.35, 0); a0.Parent = ball
		local a1 = Instance.new("Attachment"); a1.Position = V3(0, -0.35, 0); a1.Parent = ball
		local tr = Instance.new("Trail"); tr.Attachment0 = a0; tr.Attachment1 = a1; tr.Lifetime = 0.3; tr.LightEmission = 1
		tr.Color = ColorSequence.new(c); tr.Transparency = ns(0.2, 1); tr.FaceCamera = true; tr.Parent = ball
		pr.parts = { ball, core }
	elseif kind == "meteor" then
		local rock = newPart(root, BODY[pr.side], Enum.PartType.Ball, Enum.Material.Slate, V3(4, 4, 4))
		local glow = newPart(root, Color3.fromRGB(255, 120, 40), Enum.PartType.Ball, Enum.Material.Neon, V3(5.2, 5.2, 5.2))
		glow.Transparency = 0.5; rock.CastShadow = false; glow.CastShadow = false
		local f = Instance.new("Fire"); f.Size = 14; f.Heat = 20; f.Color = Color3.fromRGB(255, 140, 50); f.SecondaryColor = Color3.fromRGB(255, 50, 20); f.Parent = glow
		local l = Instance.new("PointLight"); l.Color = Color3.fromRGB(255, 140, 60); l.Range = 40; l.Brightness = 5; l.Parent = glow
		pr.parts = { rock, glow }
	end
	projs[id] = pr
end

function Render.endProj(id)
	local pr = projs[id]
	if not pr then return end
	projs[id] = nil
	if pr.kind == "arrow" or pr.kind == "bolt" then
		-- Pfeil bleibt kurz stecken
		for _, p in ipairs(pr.parts) do Debris:AddItem(p, 2) end
		task.delay(1.4, function()
			for _, p in ipairs(pr.parts) do if p.Parent then tween(p, 0.5, { Transparency = 1 }) end end
		end)
	else
		for _, p in ipairs(pr.parts) do p:Destroy() end
	end
end

function Render.updateProjs(dt, parts, cfs)
	for id, pr in pairs(projs) do
		pr.vy = pr.vy + pr.g * dt
		pr.x = pr.x + pr.vx * dt
		pr.y = math.min(0, pr.y + pr.vy * dt)
		pr.z = pr.z + (pr.tz - pr.z) * math.min(1, dt * 3)
		local pos = W(pr.x, pr.y, pr.z)
		if pr.kind == "arrow" or pr.kind == "bolt" then
			local v = V3(pr.vx, -pr.vy, 0)
			if v.Magnitude > 1 then
				local f = CFrame.fromMatrix(pos, v.Unit, V3(-v.Unit.Y, v.Unit.X, 0))
				table.insert(parts, pr.parts[1]); table.insert(cfs, f)
				table.insert(parts, pr.parts[2]); table.insert(cfs, f * CF(pr.parts[1].Size.X / 2, 0, 0) * CFrame.Angles(0, 0, PI / 4))
			end
		else
			for _, p in ipairs(pr.parts) do table.insert(parts, p); table.insert(cfs, CF(pos)) end
			if pr.kind == "meteor" and math.random() < 0.6 then Render.emit("fire", pos, 3, 0) end
		end
		if pr.y >= 0 and pr.kind ~= "meteor" then Render.endProj(id) end
	end
end

function Render.clearProjs()
	for id in pairs(projs) do Render.endProj(id) end
end

return Render
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- Pigment Krieg: komplette Benutzeroberfläche (Menü, Shop, Schmiede, Kampf-HUD). Funktioniert mit Maus und Touch.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")

local PK = ReplicatedStorage:WaitForChild("PK")
local Config = require(PK:WaitForChild("Config"))
local Pose = require(PK:WaitForChild("Pose"))
local Lang = require(PK:WaitForChild("Lang"))
local T = Lang.t
local SocialService = game:GetService("SocialService")

local UI = {}
local player = Players.LocalPlayer

local INK = Color3.fromRGB(11, 11, 13)
local PAPER = Color3.fromRGB(246, 246, 242)
local GLASS = Color3.fromRGB(18, 18, 24)
local GOLD = Color3.fromRGB(255, 204, 61)
local MUTE = Color3.fromRGB(170, 166, 160)
local RED = Color3.fromRGB(255, 74, 74)
local GREEN = Color3.fromRGB(92, 255, 138)
local DISPLAY = Enum.Font.FredokaOne
local BODY = Enum.Font.GothamBold

local function make(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then o[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = o end
	if props and props.Parent then o.Parent = props.Parent end
	return o
end
local function corner(r) return make("UICorner", { CornerRadius = UDim.new(0, r or 12) }) end
local function stroke(c, t, tr) return make("UIStroke", { Color = c or Color3.new(1, 1, 1), Thickness = t or 1, Transparency = tr or 0.85, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function pad(n) return make("UIPadding", { PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n), PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n) }) end
local function label(props)
	local max = props.Max or 40
	props.Max = nil
	if props.Text then props.Text = T(props.Text) end
	props.BackgroundTransparency = 1
	props.Font = props.Font or BODY
	props.TextColor3 = props.TextColor3 or PAPER
	props.TextScaled = props.TextScaled ~= false
	return make("TextLabel", props, { make("UITextSizeConstraint", { MaxTextSize = max }) })
end
local function button(props, children)
	local max, r = props.Max or 22, props.R or 12
	props.Max = nil
	props.R = nil
	if props.Text then props.Text = T(props.Text) end
	props.AutoButtonColor = true
	props.Font = props.Font or BODY
	props.TextColor3 = props.TextColor3 or PAPER
	props.TextScaled = true
	local b = make("TextButton", props, children)
	corner(r).Parent = b
	make("UITextSizeConstraint", { MaxTextSize = max }).Parent = b
	make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }).Parent = b
	return b
end

------------------------------------------------------------------ Vorschau-Figuren
local function preview(parent, info, poseInfo)
	local Render = UI.Render
	local vp = make("ViewportFrame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Ambient = Color3.fromRGB(200, 200, 200), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-1, -1, -1), Parent = parent })
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vp
	vp.CurrentCamera = cam
	local st = Render.buildStick(info, vp)
	local p = Pose.compute(poseInfo or { type = info.type, moving = false, seed = 1 }, 0.3)
	local J = Pose.solve(p, info.scale or 1, 1)
	local parts, cfs = {}, {}
	Render.place(st, J, 17, 1, p, 0.3, parts, cfs)
	for i, part in ipairs(parts) do part.CFrame = cfs[i] end
	local h = 9 * (info.scale or 1)
	cam.CFrame = CFrame.lookAt(Vector3.new(0.6, h * 0.5, h * 1.55), Vector3.new(0.6, h * 0.48, 0))
	return vp
end

------------------------------------------------------------------ Aufbau
function UI.init(ctx)
	Lang.setLocale(player.LocaleId)
	UI.Render = ctx.Render
	UI.Action = ctx.Action
	UI.State = ctx.State
	local gui = make("ScreenGui", { Name = "PigmentKrieg", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = player:WaitForChild("PlayerGui") })
	UI.gui = gui
	-- Alles liegt in "base"; UIScale vergrößert/verkleinert es passend zum Bildschirm.
	-- Damit base trotzdem den ganzen Bildschirm füllt, bekommt es die Größe 1/Skalierung.
	local base = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gui })
	local scale = make("UIScale", { Parent = base })
	local function rescale()
		local v = workspace.CurrentCamera.ViewportSize
		local k = math.clamp(math.min(v.X / 1280, v.Y / 720), 0.5, 1.5)
		scale.Scale = k
		base.Size = UDim2.fromScale(1 / k, 1 / k)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	UI.base = base

	UI.buildHud(base)
	UI.buildMenu(base)
	UI.buildOverlays(base)
	UI.buildExtras(base)
	UI.buildHeroControls()
	return UI
end

function UI.data()
	local raw = player:GetAttribute("Data")
	if not raw then return nil end
	local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
	return ok and d or nil
end

------------------------------------------------------------------ HUD
function UI.buildHud(base)
	local hud = make("Frame", { Name = "Hud", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = base })
	UI.hud = hud
	-- obere Leiste
	local top = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -24, 0, 54), Position = UDim2.fromOffset(12, 10), Parent = hud })
	local function hpBar(side, pos, anchor)
		local f = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.36, 0, 1, 0), Position = pos, AnchorPoint = anchor, Parent = top })
		label({ Text = side == 1 and "SCHWARZ" or "WEISS", Size = UDim2.new(1, 0, 0, 18), TextXAlignment = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, Font = DISPLAY, Max = 16, Parent = f })
		local bar = make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 22), Parent = f }, { corner(7), stroke(nil, 1, 0.8) })
		local fill = make("Frame", { BackgroundColor3 = side == 1 and Color3.fromRGB(40, 40, 46) or PAPER, Size = UDim2.fromScale(1, 1), AnchorPoint = Vector2.new(side == 1 and 0 or 1, 0), Position = UDim2.fromScale(side == 1 and 0 or 1, 0), Parent = bar }, { corner(7) })
		make("UIGradient", { Color = side == 1 and ColorSequence.new(Color3.fromRGB(70, 70, 80), Color3.fromRGB(20, 20, 24)) or ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 194)), Parent = fill })
		local you = label({ Text = "", Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 38), TextXAlignment = side == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, TextColor3 = GOLD, Max = 13, Parent = f })
		return fill, you
	end
	UI.hp1, UI.you1 = hpBar(1, UDim2.fromScale(0, 0), Vector2.new(0, 0))
	UI.hp2, UI.you2 = hpBar(2, UDim2.new(1, -110, 0, 0), Vector2.new(1, 0))
	UI.arenaLabel = label({ Text = "", Size = UDim2.new(0.2, 0, 0, 18), Position = UDim2.new(0.5, -55, 0, 2), AnchorPoint = Vector2.new(0.5, 0), TextColor3 = MUTE, Max = 15, Parent = top })
	UI.phaseLabel = label({ Text = "", Size = UDim2.new(0.2, 0, 0, 22), Position = UDim2.new(0.5, -55, 0, 22), AnchorPoint = Vector2.new(0.5, 0), Font = DISPLAY, Max = 20, Parent = top })
	UI.menuBtn = button({ Text = "MENÜ", BackgroundColor3 = GLASS, BackgroundTransparency = 0.15, Size = UDim2.fromOffset(96, 40), Position = UDim2.new(1, 0, 0, 2), AnchorPoint = Vector2.new(1, 0), Font = DISPLAY, Max = 18, Parent = top })
	UI.menuBtn.MouseButton1Click:Connect(function() UI.menuForced = true end)

	-- Gold & Befehle
	UI.goldLabel = label({ Text = "0", Size = UDim2.fromOffset(260, 34), Position = UDim2.fromOffset(14, 74), TextXAlignment = Enum.TextXAlignment.Left, Font = DISPLAY, TextColor3 = GOLD, Max = 30, TextStrokeTransparency = 0.4, Parent = hud })
	UI.rageLabel = label({ Text = "", Size = UDim2.fromOffset(260, 24), Position = UDim2.fromOffset(14, 108), TextXAlignment = Enum.TextXAlignment.Left, Font = DISPLAY, TextColor3 = Color3.fromRGB(255, 106, 60), Max = 20, TextStrokeTransparency = 0.4, Parent = hud })
	local cmds = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(330, 40), Position = UDim2.new(1, -12, 0, 74), AnchorPoint = Vector2.new(1, 0), Parent = hud }, {
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8) }),
	})
