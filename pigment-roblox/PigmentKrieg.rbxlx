<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="ReplicatedStorage" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">PK</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Pigment Krieg: gemeinsame Spieldaten (Server + Client)
-- Einheiten im Spiel rechnen in "Pixeln" wie die Web-Version; 1 Pixel = 0.1 Stud.
local Config = {}

Config.K = 0.1            -- Studs pro Spiel-Einheit
Config.WORLD_W = 2600     -- Länge des Schlachtfelds (Spiel-Einheiten)
Config.MAX_UNITS = 45     -- pro Seite

-- Seite 1 = Schwarz (links), Seite 2 = Weiß (rechts)
Config.SIDES = {
	{ name = "Schwarz", color = { 14, 14, 17 }, ink = { 0, 0, 0 }, dir = 1 },
	{ name = "Weiß", color = { 246, 246, 240 }, ink = { 255, 255, 255 }, dir = -1 },
}

Config.UNIT_ORDER = { "sword", "spear", "archer", "shield", "ninja", "mage", "giant" }
Config.UNITS = {
	sword  = { name = "Klinge", hp = 120, dmg = 18, range = 34, cd = 0.85, atk = 0.62, speed = 80, cost = 30, spawnCd = 1.2, scale = 1.0, desc = "Schneller Schwertkämpfer" },
	spear  = { name = "Speer", hp = 155, dmg = 25, range = 62, cd = 1.10, atk = 0.70, speed = 66, cost = 50, spawnCd = 2.0, scale = 1.05, desc = "Lange Reichweite" },
	archer = { name = "Bogen", hp = 80, dmg = 16, range = 370, cd = 1.55, atk = 0.95, speed = 70, cost = 55, spawnCd = 2.2, scale = 1.0, desc = "Schießt Pfeile", ranged = true },
	shield = { name = "Schild", hp = 330, dmg = 11, range = 30, cd = 1.15, atk = 0.55, speed = 52, cost = 75, spawnCd = 3.0, scale = 1.08, desc = "Blockt von vorne" },
	ninja  = { name = "Ninja", hp = 95, dmg = 12, range = 28, cd = 0.30, atk = 0.26, speed = 135, cost = 70, spawnCd = 2.6, scale = 0.92, desc = "Blitzschnelle Dolche" },
	mage   = { name = "Magier", hp = 90, dmg = 34, range = 300, cd = 2.6, atk = 1.10, speed = 62, cost = 95, spawnCd = 4.0, scale = 1.0, desc = "Explodierende Kugeln", ranged = true, aoe = 62 },
	hero   = { name = "Held", hp = 650, dmg = 40, range = 40, cd = 0.55, atk = 0.5, speed = 150, cost = 0, spawnCd = 0, scale = 1.35, desc = "Das bist du!" },
	giant  = { name = "Titan", hp = 720, dmg = 62, range = 60, cd = 2.10, atk = 1.15, speed = 40, cost = 160, spawnCd = 6.0, scale = 1.75, desc = "Hammer mit Flächenschaden", aoe = 85 },
}
Config.HIT_AT = { sword = 0.5, spear = 0.55, archer = 0.62, ninja = 0.5, giant = 0.58, shield = 0.52, mage = 0.64 }

Config.TIERS = {
	{ name = "Holz", color = { 154, 106, 58 }, neon = false },
	{ name = "Eisen", color = { 195, 204, 214 }, neon = false },
	{ name = "Gold", color = { 255, 204, 61 }, neon = false },
	{ name = "Diamant", color = { 127, 244, 255 }, neon = true },
	{ name = "Plasma", color = { 255, 77, 245 }, neon = true },
}
Config.UPGRADE_COST = { 120, 260, 480, 800 } -- Holz->Eisen, ->Gold, ->Diamant, ->Plasma

Config.HELMETS = {
	{ id = "none", name = "Ohne Helm", price = 0 },
	{ id = "knight", name = "Ritterhelm", price = 120 },
	{ id = "ninja", name = "Ninja-Band", price = 150 },
	{ id = "viking", name = "Wikingerhelm", price = 180 },
	{ id = "sparta", name = "Spartaner", price = 220 },
	{ id = "face", name = "Gesichts-Helm", price = 250 },
	{ id = "crown", name = "Königskrone", price = 400 },
	-- Premium: mit vielen Münzen ODER Robux
	{ id = "halo", name = "Heiligenschein", price = 3000, robux = "halo", premium = true },
	{ id = "visor", name = "Neon-Visier", price = 4000, robux = "visor", premium = true },
	{ id = "flame", name = "Flammenkopf", price = 6000, robux = "flame", premium = true },
	{ id = "dragon", name = "Drachenhelm", price = 8000, robux = "dragon", premium = true },
	-- nur mit dem VIP-Pass
	{ id = "vipcrown", name = "VIP-Krone", price = 0, pass = "vip", premium = true },
}

-- Spielmodi (Abstimmung im Menü)
Config.MODE_ORDER = { "classic", "steal", "hill", "sudden", "turbo", "boss", "waves" }
Config.MODES = {
	classic = { name = "Klassisch", desc = "Zerstöre die feindliche Burg" },
	waves = { name = "Überleben", desc = "Halte gegen endlose Wellen durch (alle im Team Schwarz)" },
	boss = { name = "Boss-Ansturm", desc = "Alle 45 Sekunden kommt ein Boss-Titan" },
	turbo = { name = "Turbo", desc = "Doppelt so viel Gold, halbe Wartezeiten" },
	hill = { name = "Hügel-König", desc = "Halte die Mitte! Wer zuerst 100 Punkte hat, gewinnt" },
	sudden = { name = "Sudden Death", desc = "Schwache Burgen, harte Treffer, schnelle Runden" },
	steal = { name = "Pigment-Raub", desc = "Klau mit deinem Helden die Farbe des Gegners! 3 Punkte gewinnen" },
}

-- Robux-Shop. Die IDs bekommst du auf create.roblox.com (siehe README, Abschnitt Robux-Shop).
-- id = 0 bedeutet: noch nicht eingerichtet -> der Knopf zeigt "Bald".
Config.PASSES = {
	vip = { id = 0, name = "VIP", robux = 199, desc = "Doppelte Münzen nach jedem Kampf + VIP-Krone" },
	rainbow = { id = 0, name = "Regenbogen-Waffen", robux = 149, desc = "Alle deine Waffen leuchten in Regenbogenfarben" },
}
Config.PRODUCTS = {
	coins1 = { id = 0, name = "1.000 Münzen", robux = 25, coins = 1000 },
	coins2 = { id = 0, name = "6.000 Münzen", robux = 99, coins = 6000 },
	coins3 = { id = 0, name = "20.000 Münzen", robux = 249, coins = 20000 },
	halo = { id = 0, name = "Heiligenschein", robux = 49, helmet = "halo" },
	visor = { id = 0, name = "Neon-Visier", robux = 75, helmet = "visor" },
	flame = { id = 0, name = "Flammenkopf", robux = 99, helmet = "flame" },
	dragon = { id = 0, name = "Drachenhelm", robux = 149, helmet = "dragon" },
}
Config.SEARCH_TIME = 15 -- Sekunden Gegnersuche, danach Kampf gegen den Computer
Config.PRODUCT_ORDER = { "coins1", "coins2", "coins3", "halo", "visor", "flame", "dragon" }
-- Gesichts-Helm: Bild-Nummer (Image-ID) ODER Decal-Nummer bei FACE_DECAL.
-- Der Server wandelt eine Decal-Nummer beim Start automatisch in das Bild um.
Config.FACE_DECAL = 0
Config.FACE_IMAGE = ""

Config.ABILITY_ORDER = { "meteor", "rage", "heal" }
Config.ABILITIES = {
	meteor = { name = "Meteor", icon = "☄", cd = 32, key = "R", desc = "Meteor auf eine Stelle" },
	rage = { name = "Kriegsschrei", icon = "!", cd = 42, key = "F", desc = "8 Sek. schneller und stärker" },
	heal = { name = "Heilwelle", icon = "+", cd = 48, key = "H", desc = "Heilt Armee und Burg" },
}
Config.ABILITY_COST = { 220, 450 }

Config.EXTRAS = {
	{ id = "armor", name = "Rüstung", desc = "+15 % Leben für alle Krieger", max = 5, base = 150 },
	{ id = "mine", name = "Pigment-Mine", desc = "+3 Gold pro Sekunde", max = 5, base = 140 },
	{ id = "tower", name = "Burg-Turm", desc = "Mehr Burgleben, Turm schießt schneller", max = 5, base = 160 },
}

Config.ARENAS = {
	{ id = "plains", name = "Graue Steppe", diff = 1.0, reward = 90, sky = { 120, 132, 150 }, fog = { 199, 184, 162 }, ground = { 110, 106, 98 }, far = { 106, 115, 129 }, clock = 17.2 },
	{ id = "volcano", name = "Vulkankrater", diff = 1.3, reward = 130, sky = { 90, 20, 10 }, fog = { 184, 64, 26 }, ground = { 61, 44, 39 }, far = { 74, 26, 18 }, clock = 18.3 },
	{ id = "ice", name = "Eiswüste", diff = 1.55, reward = 170, sky = { 150, 185, 220 }, fog = { 220, 232, 243 }, ground = { 142, 163, 184 }, far = { 142, 167, 193 }, clock = 13 },
	{ id = "neon", name = "Neon-Kolosseum", diff = 1.8, reward = 230, sky = { 20, 10, 45 }, fog = { 69, 32, 107 }, ground = { 41, 35, 61 }, far = { 37, 22, 69 }, clock = 0.5 },
	{ id = "temple", name = "Goldener Tempel", diff = 2.1, reward = 310, sky = { 140, 95, 40 }, fog = { 230, 178, 90 }, ground = { 138, 106, 62 }, far = { 154, 113, 64 }, clock = 17.8 },
}

function Config.newData()
	return {
		coins = 300,
		helmet = "none",
		owned = { none = true },
		wlv = { sword = 1, spear = 1, archer = 1, shield = 1, ninja = 1, mage = 1, giant = 1 },
		ab = { meteor = 1, rage = 1, heal = 1 },
		armor = 0, mine = 0, tower = 0,
		wins = 0, kills = 0, games = 0, bestWave = 0,
		lastDaily = 0, streak = 0,
		receipts = {},
	}
end

function Config.extraCost(extra, lv)
	return math.floor(extra.base * (1.7 ^ lv) + 0.5)
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">Pose</string><ProtectedString name="Source"><![CDATA[-- Prozedurale Stickman-Animationen (gleiche Mathematik wie die Web-Version).
-- Winkel: 0 = gerade nach unten, positiv = nach vorne (Blickrichtung), ±pi = nach oben.
-- Koordinaten: y nach unten (Bildschirm-Logik); der Renderer dreht sie für 3D um.
local Pose = {}
local PI, TAU = math.pi, math.pi * 2

local function clamp(v, a, b)
	if v < a then return a elseif v > b then return b end
	return v
end
local function lerp(a, b, t) return a + (b - a) * t end
local function easeOut(t) return 1 - (1 - t) ^ 3 end
local function easeIn(t) return t * t * t end
local function easeInOut(t)
	if t < 0.5 then return 4 * t * t * t end
	return 1 - ((-2 * t + 2) ^ 3) / 2
end
local function seg(t, a, b) return clamp((t - a) / (b - a), 0, 1) end
Pose.clamp, Pose.lerp, Pose.easeIn, Pose.easeOut = clamp, lerp, easeIn, easeOut

function Pose.base()
	return { lean = 0, lT = 0.08, lS = -0.05, rT = -0.08, rS = -0.12, lU = 0.15, lF = 0.45, rU = 0.25, rF = 1.0,
		w = 2.4, w2 = 2.4, lunge = 0, crouch = 0, headTilt = 0, bob = 0, spin = 0, draw = 0, charge = 0 }
end

local function walk(p, q, amp)
	local s, c = math.sin(q), math.cos(q)
	p.lT = 0.55 * s * amp
	p.lS = p.lT - (0.12 + 0.95 * math.max(0, c)) * amp
	p.rT = -0.55 * s * amp
	p.rS = p.rT - (0.12 + 0.95 * math.max(0, -c)) * amp
	p.lU = -0.45 * s * amp + 0.1
	p.lF = p.lU + 0.5
	p.lean = 0.12 * amp
	p.bob = math.abs(math.sin(q)) * 2.2 * amp
end

local function attack(u, p, t)
	local ty = u.type
	if ty == "sword" then
		if t < 0.38 then
			local k = easeOut(seg(t, 0, 0.38))
			p.rU = lerp(0.35, -2.5, k); p.rF = p.rU - 0.25; p.w = p.rU - 0.35; p.lean = lerp(0.04, -0.18, k); p.lU = lerp(0.1, 0.9, k); p.lF = p.lU + 0.3
		elseif t < 0.56 then
			local k = easeIn(seg(t, 0.38, 0.56))
			p.rU = lerp(-2.5, -4.95, k); p.rF = p.rU + 0.12; p.w = p.rU + 0.25; p.lean = lerp(-0.18, 0.42, k); p.lunge = 9 * k
			p.lU = lerp(0.9, -0.5, k); p.lF = p.lU + 0.4; p.lT = lerp(0, 0.55, k); p.lS = p.lT - 0.4; p.rT = lerp(0, -0.5, k); p.rS = p.rT
		else
			local k = easeInOut(seg(t, 0.56, 1))
			p.rU = lerp(1.33, 0.35, k); p.rF = lerp(1.45, 1.2, k); p.w = lerp(1.58, 2.5, k); p.lean = lerp(0.42, 0.04, k); p.lunge = 9 * (1 - k)
			p.lU = lerp(-0.5, 0.1, k); p.lF = p.lU + 0.4; p.lT = 0.55 * (1 - k); p.lS = p.lT - 0.4 * (1 - k); p.rT = -0.5 * (1 - k); p.rS = p.rT
		end
	elseif ty == "spear" then
		if t < 0.45 then
			local k = easeOut(seg(t, 0, 0.45))
			p.rU = lerp(0.5, -0.25, k); p.rF = 1.5; p.lU = lerp(0.95, 0.35, k); p.lF = 1.5; p.lean = lerp(0, -0.2, k); p.lunge = -6 * k; p.rT = -0.3 * k; p.rS = p.rT - 0.2 * k
		elseif t < 0.6 then
			local k = easeIn(seg(t, 0.45, 0.6))
			p.rU = lerp(-0.25, 1.4, k); p.rF = 1.57; p.lU = lerp(0.35, 1.5, k); p.lF = 1.57; p.lean = lerp(-0.2, 0.45, k); p.lunge = lerp(-6, 16, k)
			p.lT = 0.7 * k; p.lS = p.lT - 0.6 * k; p.rT = -0.6 * k; p.rS = p.rT
		else
			local k = easeInOut(seg(t, 0.6, 1))
			p.rU = lerp(1.4, 0.5, k); p.lU = lerp(1.5, 0.95, k); p.rF = 1.5; p.lF = 1.5; p.lean = lerp(0.45, 0, k); p.lunge = 16 * (1 - k)
			p.lT = 0.7 * (1 - k); p.lS = p.lT - 0.6 * (1 - k); p.rT = -0.6 * (1 - k); p.rS = p.rT
		end
		p.w = 1.6 + p.lean * 0.15
	elseif ty == "archer" then
		p.lU = 1.5; p.lF = 1.56; p.w = 1.56; p.lean = 0.02
		if t < 0.6 then
			local k = easeOut(seg(t, 0, 0.6))
			p.rU = lerp(0.9, 1.25, k); p.rF = lerp(1.5, -1.45, k); p.draw = k; p.lean = -0.08 * k; p.rT = -0.25 * k; p.lT = 0.2 * k
		else
			local k = easeOut(seg(t, 0.6, 1))
			p.rU = lerp(1.0, 0.4, k); p.rF = lerp(-1.6, 0.9, k); p.draw = 0; p.lean = lerp(-0.12, 0.02, k); p.rT = -0.25 * (1 - k); p.lT = 0.2 * (1 - k)
		end
	elseif ty == "ninja" then
		local alt = u.combo % 2 == 0
		local k1, k2, k3 = seg(t, 0, 0.35), seg(t, 0.35, 0.65), seg(t, 0.65, 1)
		local a
		if k2 > 0 then
			if k3 > 0 then a = 1.65 * (1 - easeInOut(k3)) + 0.6 * easeInOut(k3) else a = lerp(-0.4, 1.65, easeIn(k2)) end
		else
			a = lerp(0.6, -0.4, easeOut(k1))
		end
		if alt then p.rU = a; p.rF = a + 0.15; p.w = a + 0.1 else p.lU = a; p.lF = a + 0.15; p.w2 = a + 0.1 end
		p.lean = 0.3 + ((k2 > 0 and k3 == 0) and 0.2 or 0)
		p.lunge = k2 > 0 and 8 * (1 - k3) or 0
		if u.combo % 4 == 3 then
			p.spin = easeInOut(seg(t, 0.1, 0.9)) * TAU
			p.bob = math.sin(seg(t, 0, 1) * PI) * 18
		end
	elseif ty == "shield" then
		if t < 0.4 then
			local k = easeOut(seg(t, 0, 0.4))
			p.rU = lerp(0.25, -1.9, k); p.rF = p.rU - 0.4; p.w = p.rU - 0.5; p.lean = lerp(0.06, -0.12, k)
		elseif t < 0.55 then
			local k = easeIn(seg(t, 0.4, 0.55))
			p.rU = lerp(-1.9, 1.5, k); p.rF = p.rU + 0.1; p.w = p.rU + 0.2; p.lean = lerp(-0.12, 0.35, k); p.lunge = 7 * k; p.lU = 1.4; p.lF = 1.55
		else
			local k = easeInOut(seg(t, 0.55, 1))
			p.rU = lerp(1.5, 0.25, k); p.rF = lerp(1.6, 0.9, k); p.w = lerp(1.7, 2.5, k); p.lean = lerp(0.35, 0.06, k); p.lunge = 7 * (1 - k)
		end
	elseif ty == "mage" then
		if t < 0.58 then
			local k = easeOut(seg(t, 0, 0.58))
			p.rU = lerp(0.35, -2.7, k); p.rF = lerp(0.5, -2.9, k); p.w = lerp(PI - 0.12, -3.0, k); p.lU = lerp(0.2, 1.4, k); p.lF = lerp(0.9, 1.6, k)
			p.lean = lerp(0.04, -0.2, k); p.bob = 6 * k; p.charge = k
		elseif t < 0.7 then
			local k = easeIn(seg(t, 0.58, 0.7))
			p.rU = lerp(-2.7, -4.7, k); p.rF = p.rU; p.w = p.rU; p.lean = lerp(-0.2, 0.4, k); p.lunge = 8 * k; p.bob = 6 * (1 - k); p.charge = 1 - k
		else
			local k = easeInOut(seg(t, 0.7, 1))
			p.rU = lerp(1.58, 0.35, k); p.rF = lerp(1.58, 0.5, k); p.w = lerp(1.58, PI - 0.12, k); p.lean = lerp(0.4, 0.04, k); p.lunge = 8 * (1 - k)
		end
	elseif ty == "giant" then
		if t < 0.48 then
			local k = easeOut(seg(t, 0, 0.48))
			p.rU = lerp(0.45, -2.9, k); p.lU = lerp(0.6, -2.75, k); p.rF = p.rU - 0.15; p.lF = p.lU - 0.1; p.w = p.rU - 0.2; p.lean = lerp(0.05, -0.28, k); p.bob = 4 * k
		elseif t < 0.6 then
			local k = easeIn(seg(t, 0.48, 0.6))
			p.rU = lerp(-2.9, -4.7, k); p.lU = lerp(-2.75, -4.65, k); p.rF = p.rU + 0.1; p.lF = p.lU + 0.1; p.w = p.rU + 0.15
			p.lean = lerp(-0.28, 0.6, k); p.crouch = 8 * k; p.lT = 0.5 * k; p.lS = p.lT - 0.7 * k; p.rT = -0.5 * k; p.rS = p.rT - 0.3 * k
		else
			local k = easeInOut(seg(t, 0.6, 1))
			p.rU = lerp(1.58, 0.45, k); p.lU = lerp(1.63, 0.6, k); p.rF = lerp(1.68, 1.6, k); p.lF = lerp(1.73, 1.55, k); p.w = lerp(1.73, 2.7, k)
			p.lean = lerp(0.6, 0.05, k); p.crouch = 8 * (1 - k); p.lT = 0.5 * (1 - k); p.lS = p.lT - 0.7 * (1 - k); p.rT = -0.5 * (1 - k); p.rS = p.rT - 0.3 * (1 - k)
		end
	end
end

-- u: { type, moving, phase, seed, attacking, atkT, combo, hurt, blockT, cheer, victory }
function Pose.compute(u, time)
	local p = Pose.base()
	local ty = u.type
	local q = u.phase or 0
	if u.moving then
		walk(p, q, ty == "ninja" and 1.25 or (ty == "giant" and 0.75 or 1))
	else
		local br = math.sin(time * 2.4 + (u.seed or 0)) * 0.04
		p.lean = 0.04 + br; p.lU = 0.12 + br; p.lF = 0.4
	end
	if ty == "sword" then p.rU = 0.35 + (u.moving and 0.25 * math.sin(q) or 0); p.rF = 1.2; p.w = 2.5 end
	if ty == "spear" then p.rU = 0.5; p.rF = 1.45; p.lU = 0.95; p.lF = 1.5; p.w = 1.62 end
	if ty == "archer" then p.lU = 0.9; p.lF = 1.25; p.rU = 0.3; p.rF = 0.9; p.w = 1.3 end
	if ty == "ninja" then p.rU = 0.6; p.rF = 1.9; p.lU = -0.4; p.lF = 0.4; p.w = 2.1; p.w2 = -2.6; p.lean = p.lean + 0.22; p.crouch = 3 end
	if ty == "giant" then p.rU = 0.45; p.rF = 1.6; p.lU = 0.6; p.lF = 1.55; p.w = 2.7; p.lean = p.lean + 0.05 end
	if ty == "shield" then p.lU = 1.05; p.lF = 1.45; p.rU = 0.25; p.rF = 0.9; p.w = 2.5; p.lean = p.lean + 0.06 end
	if ty == "mage" then
		p.rU = 0.35; p.rF = 0.5; p.w = PI - 0.12; p.lU = 0.2 + math.sin(time * 3 + (u.seed or 0)) * 0.15; p.lF = 0.9
		if not u.moving then p.bob = 1.5 + math.sin(time * 2.2 + (u.seed or 0)) * 1.5 end
	end
	if u.attacking then attack(u, p, clamp(u.atkT or 0, 0, 1)) end
	if (u.blockT or 0) > 0 then
		local k = clamp(u.blockT / 0.3, 0, 1)
		p.lU = lerp(p.lU, 1.5, k); p.lF = lerp(p.lF, 1.62, k); p.lean = p.lean - 0.12 * k; p.crouch = 4 * k; p.lunge = -3 * k
	end
	if (u.cheer or 0) > 0 then
		local k = math.sin(clamp(u.cheer / 0.8, 0, 1) * PI)
		p.rU = lerp(p.rU, -2.8, k); p.rF = lerp(p.rF, -3.0, k); p.w = lerp(p.w, -3.1, k); p.lU = lerp(p.lU, -2.5, k); p.lF = lerp(p.lF, -2.7, k)
		p.lean = p.lean - 0.15 * k; p.headTilt = -0.3 * k
	end
	if (u.hurt or 0) > 0 then
		local h = u.hurt / 0.22
		p.lean = p.lean - 0.35 * h; p.headTilt = -0.35 * h; p.lU = p.lU - 0.6 * h
	end
	if u.victory then
		local v = math.sin(time * 9 + (u.seed or 0))
		p.rU = -2.9 + v * 0.2; p.rF = -3.0; p.w = -3.1; p.lU = -2.6; p.lF = -2.8; p.lean = -0.1; p.bob = math.max(0, v) * 6
	end
	return p
end

local function limb(px, py, a, L, dir)
	return px + math.sin(a) * L * dir, py + math.cos(a) * L
end

-- Gelenke relativ zu den Füßen (0,0). Liefert Tabelle mit {x,y}-Paaren.
function Pose.solve(p, s, dir)
	local TH, SH, TO, UA, FA = 15 * s, 15 * s, 24 * s, 12 * s, 12 * s
	local lKx, lKy = limb(0, 0, p.lT, TH, dir)
	local lFx, lFy = limb(lKx, lKy, p.lS, SH, dir)
	local rKx, rKy = limb(0, 0, p.rT, TH, dir)
	local rFx, rFy = limb(rKx, rKy, p.rS, SH, dir)
	local oy = -math.max(lFy, rFy) - p.bob + p.crouch * s
	local ox = p.lunge * s * dir
	local J = {}
	J.hip = { ox, oy }
	J.lK = { lKx + ox, lKy + oy }; J.lFt = { lFx + ox, lFy + oy }
	J.rK = { rKx + ox, rKy + oy }; J.rFt = { rFx + ox, rFy + oy }
	J.neck = { ox + math.sin(p.lean) * TO * dir, oy - math.cos(p.lean) * TO }
	J.sh = { lerp(ox, J.neck[1], 0.9), lerp(oy, J.neck[2], 0.9) }
	local x, y = limb(J.sh[1], J.sh[2], p.lU, UA, dir); J.lE = { x, y }
	x, y = limb(x, y, p.lF, FA, dir); J.lH = { x, y }
	x, y = limb(J.sh[1], J.sh[2], p.rU, UA, dir); J.rE = { x, y }
	x, y = limb(x, y, p.rF, FA, dir); J.rH = { x, y }
	local hr = 7.6 * s
	local ha = p.lean + p.headTilt
	J.headR = hr
	J.headA = ha
	J.head = { J.neck[1] + math.sin(ha) * (hr + 1.5 * s) * dir, J.neck[2] - math.cos(ha) * (hr + 1.5 * s) }
	-- Salto (Ninja): alles um die Hüfte drehen
	if p.spin and p.spin ~= 0 then
		local c, sn = math.cos(p.spin * dir), math.sin(p.spin * dir)
		for k, v in pairs(J) do
			if type(v) == "table" then
				local dx, dy = v[1] - ox, v[2] - oy
				J[k] = { ox + dx * c - dy * sn, oy + dx * sn + dy * c }
			end
		end
		J.headA = J.headA + p.spin
	end
	return J
end

return Pose
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">Lang</string><ProtectedString name="Source"><![CDATA[-- Sprachen: Deutsch ist der Quelltext, Englisch für alle anderen Spieler.
-- Lang.t("Deutscher Text") liefert die Übersetzung, wenn der Spieler kein Deutsch eingestellt hat.
local Lang = {}
Lang.german = false

local EN = {
	-- Menü
	["SCHLACHT"] = "BATTLE", ["HELME"] = "HELMETS", ["WAFFEN"] = "WEAPONS", ["SHOP R$"] = "SHOP R$",
	["SPIELEN"] = "PLAY", ["TRAINING"] = "TRAINING",
	["Gegen echte Spieler"] = "Fight real players", ["Gegen den Computer"] = "Against the computer",
