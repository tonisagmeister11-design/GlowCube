<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@mipmap/ic_launcher" android:layout_marginEnd="12dp" android:contentDescription="BikeOra" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/wBig" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,0 km"
            android:textColor="#0D2B3E" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/wSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="diese Woche"
            android:textColor="#0C9A68" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/wLine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
            android:textColor="#5F7184" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
